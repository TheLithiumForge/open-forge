{
    "name": "open-forge",
    "version": "0.0.0",
    "description": "A user-owned, human-readable, file-native operating layer for Adaptive Context Engineering.",
    "type": "module",
    "packageManager": "bun@1.3.11",
    "bin": {
        "open-forge": "./dist/cli.mjs"
    },
    "files": [
        "dist/cli.mjs",
        "docs/cli.md",
        "docs/dev.md",
        "docs/extensions.md",
        "src/open-forge",
        "src/extensions",
        "!src/open-forge/**/.obsidian",
        "!src/open-forge/**/.obsidian/**",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "bench": "bun run benchmarks/harness/runner.ts",
        "build": "bun run build.ts",
        "index": "bun run src/cli/cli.ts index ./src/open-forge",
        "test": "bun run test:fast",
        "test:fast": "bun run tests/run-tests.ts unit",
        "test:closure": "bun run tests/run-tests.ts closure",
        "test:ci": "bun run tests/run-tests.ts all",
        "pack:local": "npm link"
    },
    "engines": {
        "node": ">=18"
    }
}
