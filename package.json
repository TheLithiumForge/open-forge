{
  "name": "open-forge",
  "version": "0.0.0",
  "description": "A user-owned, human-readable, file-native operating layer for Adaptive Context Engineering.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheLithiumForge/open-forge.git"
  },
  "bin": {
    "open-forge": "./dist/cli.mjs",
    "open-forge-old": "./dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/open-forge-src",
    "docs/cli.md",
    "docs/development.md",
    "docs/extensions.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "build:assets": "bun run src/cli-mvp/build/generate-build-module.ts",
    "cli:dev": "open-forge",
    "cli:link": "node src/cli/package-managers/npm/manage.ts link",
    "cli:old": "bun run src/cli-mvp/cli.ts",
    "cli:unlink": "node src/cli/package-managers/npm/manage.ts unlink",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node --experimental-strip-types node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config --config eslint.config.ts .",
    "typecheck": "tsc --project tsconfig.json",
    "test:package-manager": "node --test src/cli/package-managers/npm/__tests__/package-manager.e2e.test.ts",
    "test:package-layout": "node node_modules/typescript/bin/tsc --project src/cli/package-managers/npm/__tests__/tsconfig.integration.json --noEmit && node --test src/cli/package-managers/npm/__tests__/stage.integration.test.ts",
    "test:package-native": "node node_modules/typescript/bin/tsc --project src/cli/package-managers/npm/__tests__/tsconfig.package-e2e.json --noEmit && node src/cli/package-managers/npm/__tests__/native-package-journey.ts",
    "apm:install": "apm install --frozen --target opencode,codex && node --experimental-strip-types src/agent-tooling/agent-projections/patch-codex-agent-models.ts",
    "check:fast": "bun run typecheck && bun run lint",
    "check": "bun run format:check && bun run typecheck && bun run lint ",
    "pack:local": "npm link"
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@bomb.sh/tab": "^0.0.21",
    "@commander-js/extra-typings": "~15.0.0",
    "commander": "~15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
