{
  "name": "open-forge",
  "version": "0.0.0",
  "description": "A user-owned, human-readable, file-native operating layer for Adaptive Context Engineering.",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheLithiumForge/open-forge.git"
  },
  "scripts": {
    "setup": "node scripts/delivery/cli.ts setup",
    "clean": "node scripts/delivery/cli.ts clean",
    "restore": "node scripts/delivery/cli.ts restore",
    "build": "node scripts/delivery/cli.ts build",
    "test": "node scripts/delivery/cli.ts test",
    "build:native": "node scripts/delivery/cli.ts build:native",
    "test:built": "node scripts/delivery/cli.ts test:built",
    "pack": "node scripts/delivery/cli.ts pack",
    "dist": "node scripts/delivery/cli.ts dist",
    "verify": "npm run check:delivery && npm run test:delivery && npm run test:package-layout && npm run check:dotnet",
    "dist:wrapper": "node scripts/delivery/cli.ts dist:wrapper",
    "publish:native": "node scripts/delivery/cli.ts publish:native",
    "publish:wrapper": "node scripts/delivery/cli.ts publish:wrapper",
    "release:select": "node scripts/delivery/cli.ts release:select",
    "release:collect": "node scripts/delivery/cli.ts release:collect",
    "publish:release": "node scripts/delivery/cli.ts publish:release",
    "version:bump": "node scripts/delivery/cli.ts version",
    "version": "node scripts/delivery/cli.ts version:sync",
    "cli:dev": "dotnet run --project src/cli/root/OpenForge.Cli/OpenForge.Cli.csproj --configuration Release --no-restore --",
    "cli:link": "node scripts/delivery/npm/manage.ts link",
    "cli:unlink": "node scripts/delivery/npm/manage.ts unlink",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "typecheck": "tsc --project tsconfig.json",
    "test:package-manager": "node --test scripts/delivery/npm/__tests__/package-manager.e2e.test.ts",
    "test:package-layout": "node --test scripts/delivery/npm/__tests__/stage.integration.test.ts",
    "test:package-native": "node scripts/delivery/npm/__tests__/native-package-journey.ts",
    "apm:install": "apm install --frozen --target opencode,codex && node scripts/agent-tooling/agent-projections/patch-codex-agent-models.ts",
    "check:fast": "npm run typecheck && npm run lint",
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "check:delivery": "npm run typecheck:delivery && npm run lint:delivery && npm run format:delivery:check",
    "lint:delivery": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 scripts/delivery",
    "format:delivery:check": "prettier --check scripts/delivery .github/workflows package.json tsconfig.json",
    "check:dotnet": "dotnet format whitespace OpenForge.Cli.slnx --no-restore --verify-no-changes && dotnet format OpenForge.Cli.slnx --no-restore --verify-no-changes --severity warn",
    "typecheck:delivery": "tsc --project tsconfig.json",
    "test:delivery": "node --test scripts/delivery/__tests__/*.test.ts scripts/delivery/release/__tests__/*.test.ts scripts/delivery/npm/__tests__/publication.integration.test.ts",
    "test:agent-tooling": "node --test scripts/agent-tooling/agent-projections/*.test.ts scripts/agent-tooling/review/*.test.ts",
    "build:launcher": "tsc --project scripts/delivery/npm/tsconfig.build.json",
    "forge": "node scripts/delivery/cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "bin": {
    "forge": "scripts/delivery/cli.ts"
  }
}
