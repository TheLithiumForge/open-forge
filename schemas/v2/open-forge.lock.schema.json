{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheLithiumForge/open-forge/main/schemas/v2/open-forge.lock.schema.json",
  "title": "Open Forge workspace lock",
  "description": "Generated by Open Forge. Records verified ownership and route-sharing choices. Sharing choices grant no deletion authority. An absent lock is known empty. Commands refuse effects that require trustworthy facts when an existing lock is invalid or unreadable.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "type": "integer",
      "description": "The shape this file was written for. A version the CLI does not recognise is read for the keys it understands and reported, never refused.",
      "minimum": 1
    },
    "framework": {
      "$ref": "#/$defs/frameworkOwnership"
    },
    "extensions": {
      "type": "array",
      "description": "One entry per installed Extension. A path owned by several Extensions is not recorded as shared; that is derived by intersecting these lists.",
      "items": {
        "$ref": "#/$defs/extensionOwnership"
      }
    },
    "libraries": {
      "type": "array",
      "description": "One entry per attached Library.",
      "items": {
        "$ref": "#/$defs/libraryOwnership"
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/toolReceipt"
      }
    },
    "toolRuns": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/toolRunRecord"
      }
    }
  },
  "$defs": {
    "ownedPaths": {
      "type": "array",
      "description": "Workspace-relative paths the CLI created in full. These may be deleted when nothing else owns them.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ownedRegions": {
      "type": "array",
      "description": "Named regions the CLI generated inside files somebody else authored. These may be rewritten; the file holding them is never deleted.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "region"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "The region marker name, such as \"entries\"."
          }
        }
      }
    },
    "frameworkOwnership": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": true,
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": ["string", "null"],
              "description": "The release that wrote these entries. Compared by version alone; no payload hash is recorded, because the lock records ownership rather than integrity."
            }
          }
        },
        "paths": {
          "$ref": "#/$defs/ownedPaths"
        },
        "regions": {
          "$ref": "#/$defs/ownedRegions"
        },
        "gitIgnoredRoutes": {
          "type": "array",
          "description": "Private route directories with one shared direct entrypoint. Install registers these before applying Gitignore. Generated shared navigation omits their private contents. These records grant no ownership or deletion authority. Absent means no sharing policy.",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["directory", "entrypoint"],
            "properties": {
              "directory": {
                "type": "string",
                "minLength": 1
              },
              "entrypoint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "extensionOwnership": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": ["string", "null"]
        },
        "source": {
          "type": ["string", "null"],
          "description": "Where the Extension was installed from, such as \"bundled\" or an explicit source path."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "paths": {
          "$ref": "#/$defs/ownedPaths"
        },
        "regions": {
          "$ref": "#/$defs/ownedRegions"
        }
      }
    },
    "libraryOwnership": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "sourceRoot", "destinationRoot"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "destinationRoot": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "$ref": "#/$defs/ownedPaths",
          "description": "Source-relative eligible paths projected as leaf links beneath destinationRoot. Their workspace destinations combine destinationRoot with each path (or use the path directly when destinationRoot is .). Directories are not recorded, because detach does not remove them."
        }
      }
    },
    "toolReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "target",
        "manifestSha256",
        "manifestBytes",
        "manifestFormat",
        "adapterRevision",
        "codeRoot",
        "hosts",
        "bindings",
        "files",
        "runtimeDirectories",
        "nativeProjects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])"
        },
        "target": {
          "enum": ["win-x64", "win-arm64", "osx-x64", "osx-arm64", "linux-x64", "linux-arm64"]
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "manifestBytes": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "manifestFormat": {
          "enum": ["json", "yaml"]
        },
        "adapterRevision": {
          "type": "integer",
          "minimum": 1
        },
        "codeRoot": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "enum": ["claude-code", "codex"]
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolBinding"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolFile"
          }
        },
        "runtimeDirectories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolDirectory"
          }
        },
        "nativeProjects": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ignorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "telemetry": {
          "type": "boolean",
          "default": false,
          "description": "Telemetry choice applied by the recorded configuration. Omission means off."
        },
        "components": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
              },
              "additionalProperties": {
                "type": "boolean"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rewrites": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ToolRewriteReceipt"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "guidance": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ToolGuidanceReceipt"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "toolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "identitySha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$(?![\\s\\S])"
        },
        "kind": {
          "enum": ["install", "archive", "runtime-state", "native-cache"]
        },
        "identitySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "toolFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeId", "path", "sha256", "executable"],
      "properties": {
        "storeId": {
          "type": ["string", "null"]
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "toolDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeId", "path", "files", "directories"],
      "properties": {
        "storeId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "toolCommandSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "host", "state", "exitCode"],
      "properties": {
        "action": {
          "enum": ["install", "uninstall", "index-cleanup", "activate", "deactivate", "telemetry-on", "telemetry-off"]
        },
        "host": {
          "anyOf": [
            {
              "enum": ["claude-code", "codex"]
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": ["planned", "started", "exited", "failed", "interrupted"]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "toolCommandReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "host", "state", "exitCode", "entry", "entrySha256", "args", "environment", "cause"],
      "properties": {
        "action": {
          "enum": ["install", "uninstall", "index-cleanup", "activate", "deactivate", "telemetry-on", "telemetry-off"]
        },
        "host": {
          "anyOf": [
            {
              "enum": ["claude-code", "codex"]
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": ["planned", "started", "exited", "failed", "interrupted"]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry": {
          "type": "string"
        },
        "entrySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "toolRunRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "target", "manifestSha256", "action", "state", "commands", "manifestBytes", "manifestFormat", "codeRoot", "hosts"],
      "properties": {
        "version": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "enum": ["install", "configure", "update", "remove", "choose"]
        },
        "state": {
          "enum": ["planned", "started", "exited", "failed", "interrupted"]
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCommandReceipt"
          }
        },
        "manifestBytes": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "manifestFormat": {
          "enum": ["json", "yaml"]
        },
        "codeRoot": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["claude-code", "codex"]
          }
        }
      }
    },
    "ToolEntryRewrite": {
      "oneOf": [
        {
          "$ref": "#/$defs/ToolJsonCommandRewrite"
        },
        {
          "$ref": "#/$defs/ToolTomlCommandRewrite"
        },
        {
          "$ref": "#/$defs/ToolHookCommandRewrite"
        },
        {
          "$ref": "#/$defs/ToolMarkedLineRewrite"
        }
      ]
    },
    "ToolJsonCommandRewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "host", "file", "pointer", "expected", "replacement"],
      "properties": {
        "kind": {
          "const": "json-command"
        },
        "id": {
          "type": "string"
        },
        "host": {
          "enum": ["claude-code", "codex"]
        },
        "file": {
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pointer": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/ToolCommandValue"
        },
        "replacement": {
          "$ref": "#/$defs/ToolCommandValue"
        }
      }
    },
    "ToolTomlCommandRewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "host", "file", "table", "expected", "replacement"],
      "properties": {
        "kind": {
          "const": "toml-command"
        },
        "id": {
          "type": "string"
        },
        "host": {
          "enum": ["claude-code", "codex"]
        },
        "file": {
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "table": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/ToolCommandValue"
        },
        "replacement": {
          "$ref": "#/$defs/ToolCommandValue"
        }
      }
    },
    "ToolHookCommandRewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "host", "file", "pointer", "expected", "replacement"],
      "properties": {
        "kind": {
          "const": "hook-command"
        },
        "id": {
          "type": "string"
        },
        "host": {
          "enum": ["claude-code", "codex"]
        },
        "file": {
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pointer": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        }
      }
    },
    "ToolMarkedLineRewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "host", "file", "startMarker", "endMarker", "expected", "replacement"],
      "properties": {
        "kind": {
          "const": "marked-line"
        },
        "id": {
          "type": "string"
        },
        "host": {
          "enum": ["claude-code", "codex"]
        },
        "file": {
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "startMarker": {
          "type": "string"
        },
        "endMarker": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        }
      }
    },
    "ToolCommandValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args"],
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ToolRewriteReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rewrite", "declined"],
      "properties": {
        "id": {
          "type": "string"
        },
        "rewrite": {
          "$ref": "#/$defs/ToolEntryRewrite"
        },
        "declined": {
          "type": "boolean"
        }
      }
    },
    "ToolGuidanceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "skillPath", "skillSha256", "line"],
      "properties": {
        "role": {
          "type": "string"
        },
        "skillPath": {
          "type": "string"
        },
        "skillSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "line": {
          "type": "string"
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "framework": {
        "source": {
          "id": "open-forge",
          "version": "0.1.0"
        },
        "paths": [".agents/loader.md"],
        "regions": [
          {
            "path": ".agents/directives/_directives.md",
            "region": "entries"
          },
          {
            "path": "AGENTS.md",
            "region": "open-forge"
          }
        ]
      },
      "extensions": [
        {
          "id": "planning",
          "version": "0.1.0",
          "source": "bundled",
          "dependencies": ["development"],
          "paths": [".agents/templates/planning/plan.md"],
          "regions": []
        }
      ],
      "libraries": [
        {
          "id": "shared",
          "sourceRoot": "libs/shared",
          "destinationRoot": ".agents",
          "paths": ["patterns/api.md"]
        }
      ]
    }
  ]
}
