{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph tool review draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "definition", "lifecycleDraft", "releaseEvidence", "guidance", "consent", "passiveObservationProposal"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "draft"
    },
    "definition": {
      "allOf": [
        {
          "$ref": "../../v1/manifest.schema.json"
        },
        {
          "properties": {
            "admission": {
              "const": "blocked"
            },
            "lifecycle": {
              "type": "null"
            },
            "qualification": {
              "properties": {
                "targets": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      ]
    },
    "lifecycleDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "uninstall", "indexCleanup", "ignorePaths"],
      "properties": {
        "install": {
          "$ref": "#/$defs/LifecycleDraftCommand"
        },
        "uninstall": {
          "$ref": "#/$defs/LifecycleDraftCommand"
        },
        "indexCleanup": {
          "$ref": "#/$defs/LifecycleDraftCommand"
        },
        "ignorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "releaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiedOn", "checksumFile", "checksumSha256", "assets", "verificationCommands", "attestedSourceCommit", "sourceNote"],
      "properties": {
        "verifiedOn": {
          "type": "string"
        },
        "checksumFile": {
          "type": "string"
        },
        "checksumSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assets": {
          "type": "object",
          "required": ["win-x64", "win-arm64", "osx-x64", "osx-arm64", "linux-x64", "linux-arm64"],
          "additionalProperties": {
            "$ref": "#/$defs/VerifiedAsset"
          },
          "minProperties": 6,
          "maxProperties": 6
        },
        "verificationCommands": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minItems": 1
        },
        "attestedSourceCommit": {
          "type": ["string", "null"]
        },
        "sourceNote": {
          "type": "string"
        }
      }
    },
    "guidance": {
      "type": "object",
      "required": ["path", "required", "delivery", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "required": {
          "const": true
        },
        "delivery": {
          "const": "pending-tool-owned-installer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "consent": {
      "type": "object",
      "required": ["source", "scope", "pending"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "scope": {
          "enum": ["project", "account"]
        },
        "pending": {
          "type": "array",
          "items": {
            "enum": ["R1", "R2"]
          },
          "minItems": 1
        }
      }
    },
    "passiveObservationProposal": {
      "type": "object",
      "required": ["serverName", "implementation", "noHostWrites", "noTomlParser", "defaultPaths", "pathNote"],
      "additionalProperties": false,
      "properties": {
        "serverName": {
          "type": "string"
        },
        "implementation": {
          "const": "pending"
        },
        "noHostWrites": {
          "const": true
        },
        "noTomlParser": {
          "const": true
        },
        "defaultPaths": {
          "type": "object",
          "required": ["claude-code", "codex"],
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 2,
          "maxProperties": 2
        },
        "pathNote": {
          "type": "string"
        }
      }
    }
  },
  "$id": "https://raw.githubusercontent.com/TheLithiumForge/open-forge/main/schemas/tools/drafts/v1/definition.schema.json",
  "$defs": {
    "LifecycleDraftCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "args", "scope", "workspaceOutputs", "timeoutSeconds", "pending"],
      "properties": {
        "state": {
          "enum": ["pending", "source-reviewed"]
        },
        "args": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "enum": ["workspace", "account"]
        },
        "workspaceOutputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "timeoutSeconds": {
          "type": "null"
        },
        "pending": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "args": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "VerifiedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "bytes", "sha256", "checksumUrl", "signatureKind", "bundleUrl", "signerIdentity", "issuer", "verified"],
      "properties": {
        "url": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checksumUrl": {
          "type": "string"
        },
        "signatureKind": {
          "enum": ["github-build-attestation", "sigstore-blob-bundle"]
        },
        "bundleUrl": {
          "type": ["string", "null"]
        },
        "signerIdentity": {
          "type": "string"
        },
        "issuer": {
          "const": "https://token.actions.githubusercontent.com"
        },
        "verified": {
          "const": true
        }
      }
    }
  }
}
