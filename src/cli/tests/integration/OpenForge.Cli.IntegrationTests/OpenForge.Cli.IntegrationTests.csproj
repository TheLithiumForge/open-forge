<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OpenForge.Cli.IntegrationTests</AssemblyName>
    <RootNamespace>OpenForge.Cli.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);XUNIT_AOT</DefineConstants>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RuntimeIdentifiers>$(OpenForgeAotRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../framework/OpenForge.Cli.Framework/OpenForge.Cli.Framework.csproj" />
    <ProjectReference Include="../../../shell/OpenForge.Cli.Shell/OpenForge.Cli.Shell.csproj" />
    <ProjectReference Include="../../../operations/OpenForge.Cli.Operations/OpenForge.Cli.Operations.csproj" />
    <ProjectReference Include="../../../rendering/OpenForge.Cli.Rendering/OpenForge.Cli.Rendering.csproj" />
    <ProjectReference Include="../../../root/OpenForge.Cli/OpenForge.Cli.csproj" />
    <ProjectReference Include="../../support/OpenForge.Cli.TestSupport/OpenForge.Cli.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../../../extensions/**/*"
             Exclude="../../../../extensions/README.md"
             Link="ExtensionCatalogue/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../open-forge/**/*"
             Link="FrameworkPayloadSource/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../support/Interaction/ScriptedCliTerminal.cs" Link="Support/Interaction/ScriptedCliTerminal.cs" />
  </ItemGroup>
</Project>
