{
  "install": ["install", "--location", "local", "--target", "claude,codex", "--yes", "--no-permissions"],
  "uninstall": ["uninstall", "--location", "local", "--target", "claude,codex", "--yes", "--keep-cli"],
  "indexCleanup": ["uninit", "${codeRoot}", "--force"],
  "telemetry": ["telemetry", "off"],
  "claude": {
    "type": "stdio",
    "command": "codegraph",
    "args": ["serve", "--mcp"],
    "alwaysLoad": true
  },
  "codex": ["[mcp_servers.codegraph]", "command = \"codegraph\"", "args = [\"serve\", \"--mcp\"]"],
  "hook": ["codegraph.cmd prompt-hook", "codegraph prompt-hook"],
  "shell": "codegraph explore \"<symbol names or question>\""
}
