{
  "name": "open-forge-evals",
  "private": true,
  "type": "module",
  "description": "Runs Open Forge evals on Claude Code and Codex in containers, and serves local results to the docs site",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "npm install && playwright install chromium",
    "login:codex": "node config/codex-login.ts",
    "test": "node tests.ts",
    "typecheck": "tsc --project tsconfig.json",
    "docs:cli": "node config/cli-reference.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.314",
    "@openai/codex": "0.166.0",
    "@tailwindcss/vite": "4.3.3",
    "@thelithiumforge/open-forge": "0.9.0-beta.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.1",
    "lucide-react": "1.65.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5"
  }
}
