{
  "name": "neon-pairs-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "build:art": "vite build --config vite.art.config.ts",
    "test:e2e": "npm run build:art && playwright test",
    "replay": "node --experimental-strip-types scripts/replay.ts"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
