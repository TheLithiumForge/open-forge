+import { useRef, useState } from 'react';
+import { formatElapsed } from '../elapsed-time.ts';
+import { createGame } from '../game.ts';
+import { useBoardClock } from '../session/use-board-clock.ts';
+import { browserStore } from '../session/use-saved-preferences.ts';
+import { freshBoardCode } from '../session/fresh-board.ts';
+import { exportTournament, importTournament } from './format.ts';
+import { sortedJson } from './json.ts';
+import {
+  champion,
+  currentName,
+  normalizeName,
+  initialState,
+  moveText,
+  nameError,
+  reducer,
+  rounds,
+  roundSize,
+} from './rules.ts';
+import { readHistory, saveHistory } from './storage.ts';
+import type { Action, State } from './rules.ts';
+
+const idleGame = createGame('np1-4-1');
+export function useKnockout(suspended = false) {
+  const [state, setState] = useState(initialState);
+  const current = useRef(state);
+  const [generation, setGeneration] = useState(0);
+  const [store] = useState(browserStore);
+  const [history, setHistory] = useState(() => readHistory(store));
+  const [notice, setNotice] = useState('');
+  const clockState = {
+    game: state.game ?? idleGame,
+    paused: suspended || state.phase !== 'playing',
+    generation,
+  };
+  const clockCurrent = useRef(clockState);
+  clockCurrent.current = clockState;
+
+  function commit(next: State): void {
+    if (next === current.current) return;
+    const previous = current.current;
+    if (
+      next.phase === 'champion' &&
+      next.tournament &&
+      (previous.phase !== 'champion' ||
+        sortedJson(previous.tournament) !== sortedJson(next.tournament))
+    ) {
+      const tournament = next.tournament;
+      setHistory((saved) =>
+        saved.items.some((item) => sortedJson(item) === sortedJson(tournament))
+          ? saved
+          : saveHistory(store, saved, tournament),
+      );
+    }
+    current.current = next;
+    clockCurrent.current = {
+      game: next.game ?? idleGame,
+      paused: suspended || next.phase !== 'playing',
+      generation,
+    };
+    setState(next);
+  }
+  const clock = useBoardClock(clockState, clockCurrent, (_generation, milliseconds) => {
+    commit(reducer(current.current, { type: 'tick', milliseconds }));
+  });
+  function dispatch(action: Action): void {
+    clock.synchronize();
+    const next = reducer(current.current, action);
+    if (next.phase !== current.current.phase) {
+      clock.reset();
+      setGeneration((value) => value + 1);
+    }
+    if (
+      action.type === 'activate' &&
+      next.game &&
+      next.game.moves !== current.current.game?.moves
+    ) {
+      setNotice(
+        next.phase === 'champion' && next.tournament
+          ? `Champion: ${champion(next.tournament)}.`
+          : next.phase !== 'playing'
+            ? `${currentName(next)} finished in ${moveText(next.game.moves)} and ${formatElapsed(next.game.elapsedMs)}.`
+            : next.game.selection.kind === 'mismatch'
+              ? 'No match. Cards close after a short pause.'
+              : 'Pair found.',
+      );
+    } else if (action.type !== 'activate') setNotice('');
+    commit(next);
+  }
+  function start(names: readonly string[]): void {
+    const error = nameError(names);
+    if (error) {
+      setNotice(error);
+      return;
+    }
+    const used = new Set<string>();
+    const codes = rounds(names.length).map((round) => {
+      let code: string;
+      do {
+        code = freshBoardCode(roundSize(round));
+      } while (used.has(code));
+      used.add(code);
+      return code;
+    });
+    dispatch({ type: 'start', names, codes });
+  }
+  function load(text: string): boolean {
+    const loaded = importTournament(text);
+    if ('error' in loaded) {
+      setNotice(loaded.error);
+      return false;
+    }
+    clock.reset();
+    setGeneration((value) => value + 1);
+    commit(loaded.state);
+    setNotice('Tournament loaded.');
+    return true;
+  }
+  function exportJson(): string | null {
+    clock.synchronize();
+    if (current.current.phase === 'setup') {
+      const error = nameError(current.current.draft.filter((name) => normalizeName(name)));
+      if (error) {
+        setNotice(error);
+        return null;
+      }
+    }
+    return exportTournament(current.current);
+  }
+  return {
+    state,
+    history,
+    notice,
+    start,
+    dispatch,
+    load,
+    exportJson,
+    generation,
+    synchronize: clock.synchronize,
+  };
+}
+export type KnockoutController = ReturnType<typeof useKnockout>;
