@@ -0,0 +1,43 @@
+import { formatElapsed } from '../elapsed-time.ts';
+import { moveText } from './rules.ts';
+import type { Tournament } from './rules.ts';
+
+export function Bracket({ tournament }: { tournament: Tournament }) {
+  return (
+    <div className="knockout-table">
+      <table>
+        <caption>Tournament bracket</caption>
+        <thead>
+          <tr>
+            <th scope="col">Round</th>
+            <th scope="col">Player</th>
+            <th scope="col">Moves</th>
+            <th scope="col">Time</th>
+          </tr>
+        </thead>
+        <tbody>
+          {tournament.matches.flatMap((match, index) =>
+            [0, 1].map((turn) => {
+              const seed = match.players[turn];
+              const result = match.results[turn];
+              return (
+                <tr key={`${index}-${turn}`}>
+                  <td>
+                    {match.round} {index + 1}
+                  </td>
+                  <td>
+                    {seed
+                      ? `${tournament.names[seed - 1]}${match.winner === seed ? ' (winner)' : ''}`
+                      : 'To be decided'}
+                  </td>
+                  <td>{result ? moveText(result.moves) : '—'}</td>
+                  <td>{result ? formatElapsed(result.time) : '—'}</td>
+                </tr>
+              );
+            }),
+          )}
+        </tbody>
+      </table>
+    </div>
+  );
+}
