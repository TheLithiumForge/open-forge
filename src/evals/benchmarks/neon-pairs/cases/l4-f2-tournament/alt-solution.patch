--- /dev/null
+++ b/src/game/knockout/validation.ts
@@ -0,0 +1,94 @@
+import { ELAPSED_MAX_MS, MOVES_MAX } from '../game.ts';
+import { decodeSnapshot } from '../snapshot.ts';
+import { hasExactKeys, isJsonObject } from '../saved-format.ts';
+import { createTournament, normalizeName, recordResult, roundSize } from './rules.ts';
+import { sortedJson } from './json.ts';
+import type { GameState } from '../game.ts';
+import type { Tournament } from './rules.ts';
+const TOURNAMENT_KEYS = ['names', 'matches'];
+const MATCH_KEYS = ['round', 'boardCode', 'players', 'results', 'winner'];
+const RESULT_KEYS = ['moves', 'time'];
+
+function finiteTime(value: unknown): value is number {
+  return (
+    typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= ELAPSED_MAX_MS
+  );
+}
+export function readTournament(value: unknown): Tournament | null {
+  if (
+    !isJsonObject(value) ||
+    !hasExactKeys(value, TOURNAMENT_KEYS) ||
+    !Array.isArray(value.names) ||
+    !value.names.every((name): name is string => typeof name === 'string') ||
+    !Array.isArray(value.matches)
+  )
+    return null;
+  let tournament = createTournament(
+    value.names,
+    value.matches.map((match: unknown) =>
+      isJsonObject(match) && typeof match.boardCode === 'string' ? match.boardCode : '',
+    ),
+  );
+  if (!tournament) return null;
+  let unfinished = false;
+  for (const [index, raw] of value.matches.entries()) {
+    if (
+      !isJsonObject(raw) ||
+      !hasExactKeys(raw, MATCH_KEYS) ||
+      !Array.isArray(raw.results) ||
+      raw.results.length > 2
+    )
+      return null;
+    if (unfinished && raw.results.length) return null;
+    for (const result of raw.results) {
+      const minimum = roundSize(tournament.matches[index]!.round) ** 2 / 2;
+      if (
+        !isJsonObject(result) ||
+        !hasExactKeys(result, RESULT_KEYS) ||
+        typeof result.moves !== 'number' ||
+        !Number.isSafeInteger(result.moves) ||
+        result.moves < minimum ||
+        result.moves > MOVES_MAX ||
+        !finiteTime(result.time)
+      )
+        return null;
+      tournament = recordResult(tournament, index, { moves: result.moves, time: result.time });
+    }
+    if (raw.results.length < 2) unfinished = true;
+    if (sortedJson(raw) !== sortedJson(tournament.matches[index])) return null;
+  }
+  return { ...tournament, names: value.names.map(normalizeName) };
+}
+export function readGame(value: unknown): GameState | null {
+  if (!isJsonObject(value) || !finiteTime(value.elapsedMs) || !isJsonObject(value.selection))
+    return null;
+  if (value.started === false && value.elapsedMs !== 0) return null;
+  const selection = value.selection;
+  const remainingMs = selection.remainingMs;
+  if (selection.kind === 'mismatch' && (!finiteTime(remainingMs) || remainingMs <= 0)) return null;
+  const game = decodeSnapshot(
+    JSON.stringify({
+      ...value,
+      elapsedMs: Math.floor(value.elapsedMs),
+      selection:
+        selection.kind === 'mismatch'
+          ? {
+              ...selection,
+              remainingMs: typeof remainingMs === 'number' ? Math.ceil(remainingMs) : 0,
+            }
+          : selection,
+    }),
+  );
+  return game
+    ? {
+        ...game,
+        elapsedMs: value.elapsedMs,
+        selection:
+          selection.kind === 'mismatch' &&
+          game.selection.kind === 'mismatch' &&
+          typeof remainingMs === 'number'
+            ? { ...game.selection, remainingMs }
+            : game.selection,
+      }
+    : null;
+}
