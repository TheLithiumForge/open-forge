+import { useLayoutEffect, useRef } from 'react';
+
+export function LeaveDialog({ keep, leave }: { keep(): void; leave(): void }) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  const keepButton = useRef<HTMLButtonElement>(null);
+  useLayoutEffect(() => {
+    dialog.current?.showModal();
+    keepButton.current?.focus();
+  }, []);
+  function keepPlaying(): void {
+    dialog.current?.close();
+    keep();
+  }
+  return (
+    <dialog
+      ref={dialog}
+      className="knockout-dialog"
+      aria-labelledby="leave-title"
+      onCancel={(event) => {
+        event.preventDefault();
+        keepPlaying();
+      }}
+    >
+      <h2 id="leave-title">Leave unfinished work?</h2>
+      <p>Your unfinished progress will be replaced.</p>
+      <div className="controls">
+        <button className="control" ref={keepButton} onClick={keepPlaying}>
+          Keep playing
+        </button>
+        <button
+          className="control"
+          onClick={() => {
+            dialog.current?.close();
+            leave();
+          }}
+        >
+          Leave
+        </button>
+      </div>
+    </dialog>
+  );
+}
diff --git a/src/game/knockout/Tournament.tsx b/src/game/knockout/Tournament.tsx
new file mode 100644
index 0000000..a900112
--- /dev/null
+++ b/src/game/knockout/Tournament.tsx
@@ -0,0 +1,157 @@
+import { useLayoutEffect, useRef, useState } from 'react';
+import { Board } from '../board/Board.tsx';
+import { formatElapsed } from '../elapsed-time.ts';
+import { champion, moveText } from './rules.ts';
+import { importTournament } from './format.ts';
+import { STORAGE_NOTICE } from './storage.ts';
+import type { BoardFocus } from '../board/Board.tsx';
+import { Entrants } from './Entrants.tsx';
+import { Bracket } from './Bracket.tsx';
+import type { KnockoutController } from './use-knockout.ts';
+import './knockout.css';
+
+interface Props {
+  controller: KnockoutController;
+  back(): void;
+  confirm(action: () => void): void;
+}
+export function Tournament({ controller, back, confirm }: Props) {
+  const { state, history, notice } = controller;
+  const [json, setJson] = useState('');
+  const [loadNumber, setLoadNumber] = useState(0);
+  const heading = useRef<HTMLHeadingElement>(null);
+  const board = useRef<BoardFocus>(null);
+  const unfinished =
+    (state.phase !== 'setup' && state.phase !== 'champion') ||
+    (state.phase === 'setup' && state.draft.some((name) => name.trim()));
+  useLayoutEffect(() => {
+    heading.current?.focus();
+  }, [state.phase, state.index, loadNumber]);
+  const tournament = state.tournament;
+  function leave(): void {
+    const action = () => {
+      controller.dispatch({ type: 'leave' });
+      back();
+    };
+    if (unfinished) confirm(action);
+    else action();
+  }
+  function load(): void {
+    // Validate before asking to replace unfinished work.
+    const parsed = importTournament(json);
+    const action = () => {
+      if (controller.load(json)) setLoadNumber((value) => value + 1);
+    };
+    if ('state' in parsed && unfinished) confirm(action);
+    else action();
+  }
+  return (
+    <section className="knockout" aria-labelledby="tournament-title">
+      <h2 id="tournament-title" tabIndex={-1} ref={heading}>
+        {state.phase === 'champion' && tournament
+          ? `Champion: ${champion(tournament)}`
+          : 'Tournament'}
+      </h2>
+      {state.phase === 'setup' ? (
+        <>
+          <Entrants controller={controller} />
+          {history.blocked && <p>{STORAGE_NOTICE}</p>}
+          <div className="knockout-table">
+            <table>
+              <caption>Past tournaments</caption>
+              <thead>
+                <tr>
+                  <th scope="col">Champion</th>
+                  <th scope="col">Players</th>
+                  <th scope="col">Bracket</th>
+                </tr>
+              </thead>
+              <tbody>
+                {history.items.map((item, index) => (
+                  <tr key={index}>
+                    <td>{champion(item)} (winner)</td>
+                    <td>
+                      {item.names.length}: {item.names.join(', ')}
+                    </td>
+                    <td>
+                      <details>
+                        <summary>View tournament {index + 1}</summary>
+                        <Bracket tournament={item} />
+                      </details>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          {history.items.length === 0 && <p>No past tournaments.</p>}
+        </>
+      ) : (
+        <>
+          {state.phase === 'ready' && (
+            <button className="control" onClick={() => controller.dispatch({ type: 'startTurn' })}>
+              Start turn
+            </button>
+          )}
+          {state.game && state.phase === 'playing' && (
+            <>
+              <p>
+                {moveText(state.game.moves)} · {formatElapsed(state.game.elapsedMs)}
+              </p>
+              <p id="board-help" className="help">
+                Arrow keys move between cards. Enter or Space reveals a card.
+              </p>
+              <p>Board code: {state.game.boardCode}</p>
+              <Board
+                key={controller.generation}
+                ref={board}
+                game={state.game}
+                activate={(index) => controller.dispatch({ type: 'activate', index })}
+              />
+            </>
+          )}
+          {state.phase === 'turnDone' && (
+            <button className="control" onClick={() => controller.dispatch({ type: 'next' })}>
+              Next turn
+            </button>
+          )}
+          {state.phase === 'matchDone' && (
+            <button className="control" onClick={() => controller.dispatch({ type: 'next' })}>
+              Next match
+            </button>
+          )}
+          {tournament && <Bracket tournament={tournament} />}
+        </>
+      )}
+      {notice && <p className="knockout-notice">{notice}</p>}
+      <div className="controls">
+        <button className="control" onClick={leave}>
+          {state.phase === 'champion' || state.phase === 'setup'
+            ? 'Back to game'
+            : 'Leave tournament'}
+        </button>
+        <button
+          className="control"
+          onClick={() => {
+            const text = controller.exportJson();
+            if (text !== null) setJson(text);
+          }}
+        >
+          Export tournament
+        </button>
+        <button className="control" onClick={load}>
+          Load tournament
+        </button>
+      </div>
+      <div className="knockout-field">
+        <label htmlFor="tournament-json">Tournament JSON</label>
+        <textarea
+          id="tournament-json"
+          className="control"
+          value={json}
+          onChange={(event) => setJson(event.currentTarget.value)}
+        />
+      </div>
+    </section>
+  );
+}
diff --git a/src/game/knockout/format.ts b/src/game/knockout/format.ts
new file mode 100644
index 0000000..8f6bfc8
--- /dev/null
+++ b/src/game/knockout/format.ts
@@ -0,0 +1,150 @@
+import { isWon } from '../game.ts';
+import { encodeSnapshot, SNAPSHOT_KEYS } from '../snapshot.ts';
+import { hasExactKeys, isJsonObject, parseJson } from '../saved-format.ts';
+import { initialState, nameError, normalizeName } from './rules.ts';
+import type { GameState } from '../game.ts';
+import type { State } from './rules.ts';
+
+import { sortedJson } from './json.ts';
+import { readGame, readTournament } from './validation.ts';
+
+const STATE_KEYS = ['phase', 'tournament', 'index', 'game', 'draft'];
+const TOURNAMENT_KEYS = ['names', 'matches'];
+const MATCH_KEYS = ['round', 'boardCode', 'players', 'results', 'winner'];
+const RESULT_KEYS = ['moves', 'time'];
+
+type Shape = { keys: readonly string[]; children?: Record<string, Shape>; array?: Shape };
+const resultShape: Shape = { keys: RESULT_KEYS };
+const tournamentShape: Shape = {
+  keys: TOURNAMENT_KEYS,
+  children: {
+    matches: {
+      keys: [],
+      array: { keys: MATCH_KEYS, children: { results: { keys: [], array: resultShape } } },
+    },
+  },
+};
+const stateShape: Shape = {
+  keys: STATE_KEYS,
+  children: {
+    tournament: tournamentShape,
+    game: {
+      keys: SNAPSHOT_KEYS,
+      children: { selection: { keys: ['kind', 'index', 'first', 'second', 'remainingMs'] } },
+    },
+  },
+};
+function unknownField(value: unknown, shape: Shape): string | null {
+  if (shape.array) {
+    if (!Array.isArray(value)) return null;
+    for (const item of value) {
+      const error = unknownField(item, shape.array);
+      if (error) return error;
+    }
+    return null;
+  }
+  if (!isJsonObject(value)) return null;
+  // A selection's fields depend on its discriminant.
+  const keys = shape.keys.includes('kind')
+    ? value.kind === 'closed'
+      ? ['kind']
+      : value.kind === 'one'
+        ? ['kind', 'index']
+        : ['kind', 'first', 'second', 'remainingMs']
+    : shape.keys;
+  for (const key of Object.keys(value)) if (!keys.includes(key)) return `Unknown field: ${key}.`;
+  for (const [key, child] of Object.entries(shape.children ?? {})) {
+    const error = unknownField(value[key], child);
+    if (error) return error;
+  }
+  return null;
+}
+function snapshot(game: GameState | null): unknown {
+  return game
+    ? {
+        ...JSON.parse(encodeSnapshot(game)),
+        elapsedMs: game.elapsedMs,
+        selection: game.selection,
+        matched: game.matched,
+      }
+    : null;
+}
+export function exportTournament(state: State): string {
+  return sortedJson({
+    format: 'neon-pairs/tournament',
+    version: 3,
+    state: { ...state, draft: state.draft.map(normalizeName), game: snapshot(state.game) },
+  });
+}
+export function importTournament(text: string): { state: State } | { error: string } {
+  const value = text.length <= 200_000 ? parseJson(text) : undefined;
+  const unknown = unknownField(value, {
+    keys: ['format', 'version', 'state'],
+    children: { state: stateShape },
+  });
+  if (unknown) return { error: unknown };
+  const invalid = { error: 'Invalid tournament.' };
+  if (
+    !isJsonObject(value) ||
+    !hasExactKeys(value, ['format', 'version', 'state']) ||
+    value.format !== 'neon-pairs/tournament' ||
+    value.version !== 3 ||
+    !isJsonObject(value.state) ||
+    !hasExactKeys(value.state, STATE_KEYS)
+  )
+    return invalid;
+  const raw = value.state;
+  if (typeof raw.index !== 'number' || !Number.isSafeInteger(raw.index)) return invalid;
+  if (
+    !Array.isArray(raw.draft) ||
+    (raw.draft.length !== 4 && raw.draft.length !== 8) ||
+    !raw.draft.every((name): name is string => typeof name === 'string')
+  )
+    return invalid;
+  const draft = raw.draft.map(normalizeName);
+  const draftError = nameError(draft.filter(Boolean));
+  if (draftError) return { error: draftError };
+  if (raw.phase === 'setup')
+    return raw.tournament === null && raw.game === null && raw.index === 0
+      ? { state: { ...initialState, draft } }
+      : invalid;
+  if (
+    isJsonObject(raw.tournament) &&
+    Array.isArray(raw.tournament.names) &&
+    raw.tournament.names.every((name): name is string => typeof name === 'string')
+  ) {
+    const error = nameError(raw.tournament.names);
+    if (error) return { error };
+  }
+  const tournament = readTournament(raw.tournament);
+  if (!tournament) return invalid;
+  const index = tournament.matches.findIndex((match) => match.winner === null);
+  const current = index === -1 ? tournament.matches.length - 1 : index;
+  // A finished match remains on screen until Next match.
+  const matchDone =
+    raw.phase === 'matchDone' && index !== -1 && current > 0 && raw.index === current - 1;
+  if (!matchDone && raw.index !== current) return invalid;
+  const match = tournament.matches[raw.index];
+  if (!match) return invalid;
+  const game = raw.game === null ? null : readGame(raw.game);
+  if (raw.game !== null && !game) return invalid;
+  const count = match.results.length;
+  const phase = raw.phase;
+  if (phase === 'ready') {
+    if (count > 1 || game || index === -1) return invalid;
+  } else if (phase === 'playing') {
+    if (count > 1 || !game || isWon(game) || index === -1) return invalid;
+  } else if (phase === 'turnDone' || phase === 'matchDone' || phase === 'champion') {
+    if (
+      !game ||
+      !isWon(game) ||
+      count !== (phase === 'turnDone' ? 1 : 2) ||
+      (phase === 'champion' ? index !== -1 : phase === 'matchDone' ? !matchDone : index === -1)
+    )
+      return invalid;
+    const result = match.results.at(-1)!;
+    if (game.moves !== result.moves || game.elapsedMs !== result.time) return invalid;
+  } else return invalid;
+  if (game && game.boardCode !== match.boardCode) return invalid;
+  return { state: { phase, tournament, index: raw.index, game, draft } };
+}
