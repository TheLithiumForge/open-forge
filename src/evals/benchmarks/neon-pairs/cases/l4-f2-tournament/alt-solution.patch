+import { normalizeName } from './rules.ts';
+import type { KnockoutController } from './use-knockout.ts';
+
+export function Entrants({ controller }: { controller: KnockoutController }) {
+  const names = controller.state.draft;
+  return (
+    <form
+      onSubmit={(event) => {
+        event.preventDefault();
+        controller.start(names);
+      }}
+    >
+      <div className="knockout-field">
+        <label htmlFor="tournament-players">Players</label>
+        <select
+          id="tournament-players"
+          className="control"
+          value={names.length}
+          onChange={(event) =>
+            controller.dispatch({ type: 'players', count: Number(event.currentTarget.value) })
+          }
+        >
+          <option value={4}>4</option>
+          <option value={8}>8</option>
+        </select>
+      </div>
+      <div className="knockout-names">
+        {names.map((name, index) => (
+          <label className="knockout-field" key={index}>
+            Player {index + 1}
+            <input
+              className="control"
+              value={name}
+              onBlur={() => controller.dispatch({ type: 'name', index, name: normalizeName(name) })}
+              onChange={(event) =>
+                controller.dispatch({ type: 'name', index, name: event.currentTarget.value })
+              }
+            />
+          </label>
+        ))}
+      </div>
+      <button className="control" type="submit">
+        Start tournament
+      </button>
+    </form>
+  );
+}
