diff --git a/src/game/knockout/rules.test.ts b/src/game/knockout/rules.test.ts
new file mode 100644
index 0000000..e4bd664
--- /dev/null
+++ b/src/game/knockout/rules.test.ts
@@ -0,0 +1,186 @@
+import { expect, test } from 'vitest';
+import { boardCode } from '../deck.ts';
+import {
+  champion,
+  createTournament,
+  initialState,
+  nameError,
+  normalizeName,
+  reducer,
+  rounds,
+  roundSize,
+  winner,
+} from './rules.ts';
+import { exportTournament, importTournament } from './format.ts';
+import { sortedJson } from './json.ts';
+import { readHistory, saveHistory, TOURNAMENTS_KEY } from './storage.ts';
+import type { State } from './rules.ts';
+
+const names = ['Ada', 'Bea', 'Cy', 'Dee', 'Eve', 'Flo', 'Gia', 'Hal'];
+function start(count: number): State {
+  return reducer(initialState, {
+    type: 'start',
+    names: names.slice(0, count),
+    codes: rounds(count).map((round, index) => boardCode(roundSize(round), index + 1)),
+  });
+}
+function finishTurn(state: State): State {
+  state = reducer(state, { type: 'startTurn' });
+  const deck = state.game!.deck;
+  for (let face = 0; face < deck.length / 2; face += 1) {
+    for (const [index, value] of deck.entries())
+      if (face === value) state = reducer(state, { type: 'activate', index });
+    state = reducer(state, { type: 'tick', milliseconds: 10.25 });
+  }
+  return state;
+}
+function complete(count: number): State {
+  let state = start(count);
+  while (state.phase !== 'champion') {
+    state = finishTurn(state);
+    expect(importTournament(exportTournament(state))).toEqual({ state });
+    if (state.phase !== 'champion') state = reducer(state, { type: 'next' });
+  }
+  return state;
+}
+test('names normalize whitespace and NFC, count Unicode code points and compare case insensitively', () => {
+  expect(normalizeName('  A\u0301da \n  Lee  ')).toBe('Áda Lee');
+  expect(nameError(['A', 'Bea'])).toBe('Use 2 to 20 characters.');
+  expect(nameError(['😀'.repeat(20), 'Bea'])).toBeNull();
+  expect(nameError(['😀'.repeat(21), 'Bea'])).toBe('Use 2 to 20 characters.');
+  expect(nameError([' A\u0301da ', 'áda'])).toBe('Each name must be different.');
+  expect(nameError(['ΟΣ', 'οσ'])).toBe('Each name must be different.');
+  expect(nameError(['Straße', 'STRASSE'])).toBe('Each name must be different.');
+});
+test('entry seeds form the specified brackets and rounds with unique deals of the right sizes', () => {
+  expect(start(4).tournament!.matches.map((match) => match.players)).toEqual([[1, 4], [2, 3], []]);
+  expect(start(8).tournament!.matches.map((match) => match.players)).toEqual([
+    [1, 8],
+    [4, 5],
+    [3, 6],
+    [2, 7],
+    [],
+    [],
+    [],
+  ]);
+  expect(createTournament(names.slice(0, 4), ['np1-6-1', 'np1-6-1', 'np1-8-1'])).toBeNull();
+  expect(createTournament(names.slice(0, 4), ['np1-4-1', 'np1-6-2', 'np1-8-1'])).toBeNull();
+  expect(start(4).tournament!.matches.map((match) => match.round)).toEqual([
+    'Semifinal',
+    'Semifinal',
+    'Final',
+  ]);
+});
+test('fewer moves wins before active time, then the higher seed wins an exact tie', () => {
+  expect(
+    winner(
+      [4, 1],
+      [
+        { moves: 8, time: 20 },
+        { moves: 9, time: 0 },
+      ],
+    ),
+  ).toBe(4);
+  expect(
+    winner(
+      [4, 1],
+      [
+        { moves: 8, time: 20.1 },
+        { moves: 8, time: 20.2 },
+      ],
+    ),
+  ).toBe(4);
+  expect(
+    winner(
+      [4, 1],
+      [
+        { moves: 8, time: 20 },
+        { moves: 8, time: 20 },
+      ],
+    ),
+  ).toBe(1);
+});
+test('the reducer completes both bracket sizes, requires Start turn, shares deals and stops clocks between turns', () => {
+  for (const count of [4, 8]) {
+    let state = start(count);
+    expect(reducer(state, { type: 'activate', index: 0 })).toBe(state);
+    state = finishTurn(state);
+    const first = state.game!.boardCode;
+    expect(reducer(state, { type: 'tick', milliseconds: 1000 })).toBe(state);
+    state = reducer(state, { type: 'next' });
+    state = reducer(state, { type: 'startTurn' });
+    expect(state.game!.boardCode).toBe(first);
+    const completed = complete(count);
+    expect(champion(completed.tournament!)).toBe('Ada');
+    expect(completed.tournament!.matches.every((match) => match.results.length === 2)).toBe(true);
+    expect(reducer(completed, { type: 'leave' })).toEqual(initialState);
+  }
+});
+test('JSON round trips every phase and fractions, sorts nested keys and rejects unknown or inconsistent data', () => {
+  expect(importTournament(exportTournament(initialState))).toEqual({ state: initialState });
+  const draft = reducer(reducer(initialState, { type: 'players', count: 8 }), {
+    type: 'name',
+    index: 0,
+    name: '  Áda   Lee  ',
+  });
+  expect(importTournament(exportTournament(draft))).toEqual({
+    state: { ...draft, draft: ['Áda Lee', '', '', '', '', '', '', ''] },
+  });
+  const idle = JSON.parse(exportTournament(reducer(start(4), { type: 'startTurn' })));
+  idle.state.game.elapsedMs = 0.5;
+  expect(importTournament(JSON.stringify(idle))).toEqual({ error: 'Invalid tournament.' });
+  let state = start(4);
+  expect(importTournament(exportTournament(state))).toEqual({ state });
+  state = reducer(state, { type: 'startTurn' });
+  state = reducer(state, { type: 'activate', index: 0 });
+  state = reducer(state, { type: 'tick', milliseconds: 1.25 });
+  expect(importTournament(exportTournament(state))).toEqual({ state });
+  const text = exportTournament(state);
+  const value = JSON.parse(text);
+  expect(text).toBe(sortedJson(value));
+  value.state.game.selection.extra = true;
+  expect(importTournament(JSON.stringify(value))).toEqual({ error: 'Unknown field: extra.' });
+  delete value.state.game.selection.extra;
+  value.state.tournament.names[0] = 'A';
+  expect(importTournament(JSON.stringify(value))).toEqual({ error: 'Use 2 to 20 characters.' });
+  value.state.tournament.names[0] = 'Ada';
+  value.state.tournament.matches[0].winner = 4;
+  expect(importTournament(JSON.stringify(value))).toEqual({ error: 'Invalid tournament.' });
+  expect(importTournament('{')).toEqual({ error: 'Invalid tournament.' });
+});
+test('history validates envelopes, preserves corrupt storage until saving, caps at ten and survives blocked storage', () => {
+  let text = '{broken';
+  const store = {
+    getItem: () => text,
+    setItem: (key: string, value: string) => {
+      expect(key).toBe(TOURNAMENTS_KEY);
+      text = value;
+    },
+  };
+  expect(readHistory(store)).toEqual({ items: [], blocked: false });
+  expect(text).toBe('{broken');
+  let history = readHistory(store);
+  const tournament = complete(4).tournament!;
+  for (let index = 0; index < 12; index += 1)
+    history = saveHistory(store, history, {
+      ...tournament,
+      names: [`Player ${index}`, ...tournament.names.slice(1)],
+    });
+  expect(history.items).toHaveLength(10);
+  expect(history.items[0]!.names[0]).toBe('Player 11');
+  expect(readHistory(store)).toEqual(history);
+  expect(Object.keys(JSON.parse(text)).sort()).toEqual(['items', 'v']);
+  const blocked = {
+    getItem: () => {
+      throw Error('blocked');
+    },
+    setItem: () => {
+      throw Error('blocked');
+    },
+  };
+  expect(readHistory(blocked)).toEqual({ items: [], blocked: true });
+  expect(saveHistory(blocked, readHistory(blocked), tournament)).toEqual({
+    items: [tournament],
+    blocked: true,
+  });
+});
