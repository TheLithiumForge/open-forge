index 0000000..a75baa6
--- /dev/null
+++ b/src/game/knockout/rules.ts
@@ -0,0 +1,194 @@
+import { parseBoardCode } from '../deck.ts';
+import { activateCard, advanceGame, createGame, isWon } from '../game.ts';
+import type { GameState } from '../game.ts';
+
+type Round = 'Quarterfinal' | 'Semifinal' | 'Final';
+type Phase = 'setup' | 'ready' | 'playing' | 'turnDone' | 'matchDone' | 'champion';
+interface Result {
+  readonly moves: number;
+  readonly time: number;
+}
+interface Match {
+  readonly round: Round;
+  readonly boardCode: string;
+  readonly players: readonly number[];
+  readonly results: readonly Result[];
+  readonly winner: number | null;
+}
+export interface Tournament {
+  readonly names: readonly string[];
+  readonly matches: readonly Match[];
+}
+export interface State {
+  readonly draft: readonly string[];
+  readonly phase: Phase;
+  readonly tournament: Tournament | null;
+  readonly index: number;
+  readonly game: GameState | null;
+}
+export const initialState: State = {
+  phase: 'setup',
+  tournament: null,
+  index: 0,
+  game: null,
+  draft: ['', '', '', ''],
+};
+export type Action =
+  | { type: 'players'; count: number }
+  | { type: 'name'; index: number; name: string }
+  | { type: 'start'; names: readonly string[]; codes: readonly string[] }
+  | { type: 'startTurn' }
+  | { type: 'activate'; index: number }
+  | { type: 'tick'; milliseconds: number }
+  | { type: 'next' }
+  | { type: 'leave' };
+export function normalizeName(name: string): string {
+  return name.trim().replace(/\s+/gu, ' ').normalize('NFC');
+}
+export function nameError(names: readonly string[]): string | null {
+  const normalized = names.map(normalizeName);
+  if (normalized.some((name) => [...name].length < 2 || [...name].length > 20))
+    return 'Use 2 to 20 characters.';
+  if (
+    new Set(normalized.map((name) => name.toUpperCase().normalize('NFC'))).size !==
+    normalized.length
+  )
+    return 'Each name must be different.';
+  return null;
+}
+export function rounds(count: number): readonly Round[] {
+  const finals: readonly Round[] = ['Semifinal', 'Semifinal', 'Final'];
+  return count === 8 ? [...Array<Round>(4).fill('Quarterfinal'), ...finals] : finals;
+}
+export function roundSize(round: Round): number {
+  return { Quarterfinal: 4, Semifinal: 6, Final: 8 }[round];
+}
+export function createTournament(
+  names: readonly string[],
+  codes: readonly string[],
+): Tournament | null {
+  if ((names.length !== 4 && names.length !== 8) || nameError(names)) return null;
+  const schedule = rounds(names.length);
+  if (codes.length !== schedule.length || new Set(codes).size !== codes.length) return null;
+  const seeds =
+    names.length === 4
+      ? [
+          [1, 4],
+          [2, 3],
+        ]
+      : [
+          [1, 8],
+          [4, 5],
+          [3, 6],
+          [2, 7],
+        ];
+  const matches: Match[] = [];
+  for (const [index, round] of schedule.entries()) {
+    const code = codes[index];
+    if (!code || parseBoardCode(code)?.size !== roundSize(round)) return null;
+    matches.push({
+      round,
+      boardCode: code,
+      players: seeds[index] ?? [],
+      results: [],
+      winner: null,
+    });
+  }
+  return { names: names.map(normalizeName), matches };
+}
+export function winner(players: readonly number[], results: readonly Result[]): number {
+  const first = players[0]!;
+  const second = players[1]!;
+  const a = results[0]!;
+  const b = results[1]!;
+  return a.moves !== b.moves
+    ? a.moves < b.moves
+      ? first
+      : second
+    : a.time !== b.time
+      ? a.time < b.time
+        ? first
+        : second
+      : Math.min(first, second);
+}
+export function recordResult(tournament: Tournament, index: number, result: Result): Tournament {
+  const matches = [...tournament.matches];
+  const match = matches[index]!;
+  const results = [...match.results, result];
+  const won = results.length === 2 ? winner(match.players, results) : null;
+  matches[index] = { ...match, results, winner: won };
+  if (won !== null && index < matches.length - 1) {
+    const firstRoundCount = tournament.names.length / 2;
+    const target =
+      index < firstRoundCount ? firstRoundCount + Math.floor(index / 2) : matches.length - 1;
+    const next = matches[target]!;
+    matches[target] = { ...next, players: [...next.players, won] };
+  }
+  return { ...tournament, matches };
+}
+export function reducer(state: State, action: Action): State {
+  if (action.type === 'leave') return initialState;
+  if (
+    state.phase === 'setup' &&
+    action.type === 'players' &&
+    (action.count === 4 || action.count === 8)
+  )
+    return {
+      ...state,
+      draft: Array.from({ length: action.count }, (_, index) => state.draft[index] ?? ''),
+    };
+  if (state.phase === 'setup' && action.type === 'name')
+    return {
+      ...state,
+      draft: state.draft.map((name, index) => (index === action.index ? action.name : name)),
+    };
+  if (action.type === 'start') {
+    const tournament = createTournament(action.names, action.codes);
+    return tournament
+      ? { ...initialState, phase: 'ready', tournament, index: 0, game: null }
+      : state;
+  }
+  const tournament = state.tournament;
+  if (!tournament) return state;
+  const match = tournament.matches[state.index]!;
+  if (action.type === 'startTurn' && state.phase === 'ready')
+    return { ...state, phase: 'playing', game: createGame(match.boardCode) };
+  if (action.type === 'next') {
+    if (state.phase === 'turnDone') return { ...state, phase: 'ready', game: null };
+    if (state.phase === 'matchDone')
+      return { ...state, index: state.index + 1, phase: 'ready', game: null };
+  }
+  if (state.phase !== 'playing' || !state.game) return state;
+  if (action.type === 'tick') {
+    const game = advanceGame(state.game, action.milliseconds);
+    return game === state.game ? state : { ...state, game };
+  }
+  if (action.type !== 'activate') return state;
+  const game = activateCard(state.game, action.index);
+  if (game === state.game) return state;
+  if (!isWon(game)) return { ...state, game };
+  const next = recordResult(tournament, state.index, { moves: game.moves, time: game.elapsedMs });
+  const phase =
+    match.results.length === 0
+      ? 'turnDone'
+      : state.index === tournament.matches.length - 1
+        ? 'champion'
+        : 'matchDone';
+  return { ...state, game, tournament: next, phase };
+}
+export function currentName(state: State): string {
+  const tournament = state.tournament;
+  if (!tournament) return '';
+  const match = tournament.matches[state.index]!;
+  const turn =
+    state.phase === 'ready' || state.phase === 'playing'
+      ? match.results.length
+      : match.results.length - 1;
+  return tournament.names[match.players[turn]! - 1] ?? '';
+}
+export function champion(tournament: Tournament): string {
+  return tournament.names[tournament.matches.at(-1)!.winner! - 1] ?? '';
+}
+export function moveText(moves: number): string {
+  return `${moves} ${moves === 1 ? 'move' : 'moves'}`;
+}
diff --git a/src/game/knockout/storage.ts b/src/game/knockout/storage.ts
new file mode 100644
index 0000000..1ac4202
--- /dev/null
+++ b/src/game/knockout/storage.ts
@@ -0,0 +1,50 @@
+import { hasExactKeys, isJsonObject, parseJson } from '../saved-format.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import { readTournament } from './validation.ts';
+import type { Tournament } from './rules.ts';
+
+export const TOURNAMENTS_KEY = 'np3:tournaments';
+export const STORAGE_NOTICE = "Progress won't be saved on this device.";
+interface History {
+  readonly items: readonly Tournament[];
+  readonly blocked: boolean;
+}
+export function readHistory(store: PreferenceStore | null): History {
+  if (!store) return { items: [], blocked: true };
+  try {
+    const text = store.getItem(TOURNAMENTS_KEY);
+    if (!text) return { items: [], blocked: false };
+    const value = parseJson(text);
+    if (
+      !isJsonObject(value) ||
+      !hasExactKeys(value, ['v', 'items']) ||
+      value.v !== 3 ||
+      !Array.isArray(value.items) ||
+      value.items.length > 10
+    )
+      return { items: [], blocked: false };
+    const items: Tournament[] = [];
+    for (const raw of value.items) {
+      const item = readTournament(raw);
+      if (!item || item.matches.at(-1)?.winner === null) return { items: [], blocked: false };
+      items.push(item);
+    }
+    return { items, blocked: false };
+  } catch {
+    return { items: [], blocked: true };
+  }
+}
+export function saveHistory(
+  store: PreferenceStore | null,
+  history: History,
+  tournament: Tournament,
+): History {
+  const items = [tournament, ...history.items].slice(0, 10);
+  try {
+    if (!store) return { items, blocked: true };
+    store.setItem(TOURNAMENTS_KEY, JSON.stringify({ v: 3, items }));
+    return { items, blocked: history.blocked };
+  } catch {
+    return { items, blocked: true };
+  }
+}
