+import { isJsonObject } from '../saved-format.ts';
+
+export function sortedJson(value: unknown): string {
+  return JSON.stringify(
+    value,
+    (_key, item: unknown) =>
+      isJsonObject(item)
+        ? Object.fromEntries(
+            Object.keys(item)
+              .sort()
+              .map((key) => [key, item[key]]),
+          )
+        : item,
+    2,
+  );
+}
