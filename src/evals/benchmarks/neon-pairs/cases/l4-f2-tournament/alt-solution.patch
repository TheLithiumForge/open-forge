+import { expect, Scrollbars, test, TestTimeouts } from './browser-test.ts';
+import { loadTimedBoard } from './game-fixture.ts';
+import { specDeal } from './deal-oracle.ts';
+import { isJsonObject } from '../src/game/saved-format.ts';
+import type { Page } from '@playwright/test';
+
+async function exportJson(page: Page): Promise<string> {
+  await page.getByRole('button', { name: 'Export tournament', exact: true }).click();
+  return page.getByLabel('Tournament JSON', { exact: true }).inputValue();
+}
+async function playTurn(page: Page): Promise<string> {
+  await page.getByRole('button', { name: 'Start turn', exact: true }).click();
+  const code = (await page.getByText(/^Board code: /).innerText()).slice('Board code: '.length);
+  const [, size, seed] = code.split('-');
+  const deal = specDeal(Number(size), Number(seed));
+  for (let face = 0; face < deal.length / 2; face += 1) {
+    for (const [index, value] of deal.entries())
+      if (value === face) await page.locator('.card').nth(index).click({ force: true });
+    await page.clock.runFor(5);
+  }
+  return code;
+}
+for (const count of [4, 8]) {
+  test(
+    `plays a complete ${count} player tournament and reloads its history without changing normal preferences`,
+    async ({ page, gameURL }, artifacts) => {
+      await page.setViewportSize({ width: 390, height: 844 });
+      await loadTimedBoard(page, gameURL);
+      const preferences = await page.evaluate(() =>
+        localStorage.getItem('neon-pairs.preferences.v1'),
+      );
+      await page.getByRole('button', { name: 'Tournament', exact: true }).click();
+      await expect(page.getByRole('heading', { name: 'Tournament', exact: true })).toBeFocused();
+      await page.getByLabel('Players', { exact: true }).selectOption(String(count));
+      for (let player = 1; player <= count; player += 1)
+        await page.getByLabel(`Player ${player}`, { exact: true }).fill(`  Player   ${player}  `);
+      for (const control of await page
+        .locator('.knockout button, .knockout input, .knockout select, .knockout textarea')
+        .all()) {
+        const box = await control.boundingBox();
+        expect(box?.width).toBeGreaterThanOrEqual(44);
+        expect(box?.height).toBeGreaterThanOrEqual(44);
+      }
+      await page.getByRole('button', { name: 'Start tournament', exact: true }).click();
+      await expect(page.getByRole('status')).toContainText('Now playing: Player 1');
+      const saved = await exportJson(page);
+      const unknown: unknown = JSON.parse(saved);
+      if (!isJsonObject(unknown)) throw Error('Expected tournament object');
+      await page
+        .getByLabel('Tournament JSON', { exact: true })
+        .fill(JSON.stringify({ ...unknown, extra: 1 }));
+      await page.getByRole('button', { name: 'Load tournament', exact: true }).click();
+      await expect(page.getByRole('status')).toContainText('Unknown field: extra.');
+      expect(await exportJson(page)).toBe(saved);
+      await page.getByRole('button', { name: 'Load tournament', exact: true }).click();
+      await expect(page.getByRole('button', { name: 'Keep playing', exact: true })).toBeFocused();
+      await page.keyboard.press('Escape');
+      await expect(page.getByRole('dialog')).toHaveCount(0);
+      const codes = new Set<string>();
+      for (let match = 0; match < count - 1; match += 1) {
+        const round =
+          count === 8 && match < 4 ? 'Quarterfinal' : match < count - 2 ? 'Semifinal' : 'Final';
+        await expect(page.getByRole('status')).toContainText(`Round: ${round}`);
+        const first = await playTurn(page);
+        await page.getByRole('button', { name: 'Next turn', exact: true }).click();
+        expect(await playTurn(page)).toBe(first);
+        expect(codes.has(first)).toBe(false);
+        codes.add(first);
+        if (match < count - 2)
+          await page.getByRole('button', { name: 'Next match', exact: true }).click();
+      }
+      await expect(
+        page.getByRole('heading', { name: 'Champion: Player 1', exact: true }),
+      ).toBeFocused();
+      await expect(page.locator('[aria-live]')).toHaveCount(1);
+      await expect(
+        page
+          .getByRole('table', { name: 'Tournament bracket', exact: true })
+          .getByText(/\(winner\)/),
+      ).toHaveCount(count - 1);
+      await page.screenshot({ path: artifacts.outputPath('champion.png'), fullPage: true });
+      const completed = await exportJson(page);
+      await page.getByRole('button', { name: 'Back to game', exact: true }).click();
+      await expect(page.getByRole('heading', { name: 'Game', exact: true })).toBeFocused();
+      expect(await page.evaluate(() => localStorage.getItem('neon-pairs.preferences.v1'))).toBe(
+        preferences,
+      );
+      await page.reload();
+      await page.getByRole('button', { name: 'Tournament', exact: true }).click();
+      await expect(
+        page.getByRole('table', { name: 'Past tournaments', exact: true }),
+      ).toContainText('Player 1 (winner)');
+      await page.getByLabel('Tournament JSON', { exact: true }).fill(completed);
+      await page.getByRole('button', { name: 'Load tournament', exact: true }).click();
+      await expect(
+        page.getByRole('heading', { name: 'Champion: Player 1', exact: true }),
+      ).toBeFocused();
+    },
+    {},
+    Scrollbars.hidden,
+    TestTimeouts.long,
+  );
+}
+
+test('validates names, confirms replacement and restores partial tournament and normal game clocks', async ({
+  page,
+  gameURL,
+}) => {
+  await loadTimedBoard(page, gameURL);
+  await page.locator('.card').first().click();
+  await page.clock.runFor(1000);
+  const open = page.getByRole('button', { name: 'Tournament', exact: true });
+  await open.click();
+  await expect(page.getByRole('button', { name: 'Keep playing', exact: true })).toBeFocused();
+  await page.keyboard.press('Escape');
+  await expect(open).toBeFocused();
+  await open.click();
+  await page.getByRole('button', { name: 'Leave', exact: true }).click();
+  await page.clock.runFor(30_000);
+  for (const [index, name] of ['A', 'Bea', 'Cy', 'Dee'].entries())
+    await page.getByLabel(`Player ${index + 1}`, { exact: true }).fill(name);
+  await page.getByRole('button', { name: 'Start tournament', exact: true }).click();
+  await expect(page.getByRole('status')).toHaveText('Use 2 to 20 characters.');
+  await page.getByLabel('Player 1', { exact: true }).fill('  A\u0301da   Lee  ');
+  await page.getByLabel('Player 2', { exact: true }).fill('áda lee');
+  await page.getByRole('button', { name: 'Start tournament', exact: true }).click();
+  await expect(page.getByRole('status')).toHaveText('Each name must be different.');
+  await page.getByLabel('Player 2', { exact: true }).fill('Bea');
+  await page.getByRole('button', { name: 'Start tournament', exact: true }).click();
+  await page.getByRole('button', { name: 'Start turn', exact: true }).click();
+  await expect(page.getByRole('status')).toContainText('Now playing: Áda Lee');
+  await page.locator('.card').first().click();
+  await page.clock.runFor(125);
+  const saved = await exportJson(page);
+  await page.getByRole('button', { name: 'Load tournament', exact: true }).click();
+  await page.clock.runFor(30_000);
+  await page.getByRole('button', { name: 'Leave', exact: true }).click();
