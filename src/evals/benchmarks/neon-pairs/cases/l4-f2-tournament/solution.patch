+import { normalizeName } from './rules.ts';
+
+interface Props {
+  names: string[];
+  setNames(names: string[]): void;
+  start(): void;
+}
+export function Setup({ names, setNames, start }: Props) {
+  return (
+    <>
+      <p>
+        Play the same deal in each match. Fewer moves wins, then lower active time, then higher
+        seed.
+      </p>
+      <form
+        onSubmit={(event) => {
+          event.preventDefault();
+          start();
+        }}
+      >
+        <label htmlFor="tournament-players">Players</label>
+        <select
+          className="control"
+          id="tournament-players"
+          value={names.length}
+          onChange={(event) =>
+            setNames(
+              Array.from({ length: Number(event.currentTarget.value) }, (_, i) => names[i] ?? ''),
+            )
+          }
+        >
+          <option value={4}>4</option>
+          <option value={8}>8</option>
+        </select>
+        <div className="tournament-names">
+          {names.map((name, i) => (
+            <label key={i}>
+              Player {i + 1}
+              <input
+                className="control"
+                value={name}
+                onChange={(event) =>
+                  setNames(names.map((old, j) => (i === j ? event.currentTarget.value : old)))
+                }
+                onBlur={() => setNames(names.map(normalizeName))}
+                autoComplete="off"
+              />
+            </label>
+          ))}
+        </div>
+        <button className="control" type="submit">
+          Start tournament
+        </button>
+      </form>
+    </>
+  );
+}
