@@ -0,0 +1,33 @@
+import { bracket } from './rules.ts';
+import type { TournamentRecord } from './types.ts';
+import { STORAGE_NOTICE } from './history-storage.ts';
+
+interface Props {
+  items: TournamentRecord[];
+  blocked: boolean;
+  view(item: TournamentRecord): void;
+}
+export function History({ items, blocked, view }: Props) {
+  return (
+    <>
+      <h3>Past tournaments</h3>
+      {blocked && <p>{STORAGE_NOTICE}</p>}
+      {items.length ? (
+        <ol>
+          {items.map((item, i) => {
+            const seed = bracket(item).at(-1)?.winner;
+            return (
+              <li key={i}>
+                <button className="control" onClick={() => view(item)}>
+                  {item.names.length} players · Champion: {seed ? item.names[seed - 1] : ''}
+                </button>
+              </li>
+            );
+          })}
+        </ol>
+      ) : (
+        !blocked && <p>No past tournaments.</p>
+      )}
+    </>
+  );
+}
