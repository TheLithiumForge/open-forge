@@ -0,0 +1,40 @@
+import { useLayoutEffect, useRef } from 'react';
+
+export function LeaveDialog({ leave, keep }: { leave(): void; keep(): void }) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  const keepButton = useRef<HTMLButtonElement>(null);
+  useLayoutEffect(() => {
+    dialog.current?.showModal();
+    keepButton.current?.focus();
+  }, []);
+  function keepPlaying(): void {
+    dialog.current?.close();
+    keep();
+  }
+  function leavePlay(): void {
+    dialog.current?.close();
+    leave();
+  }
+  return (
+    <dialog
+      ref={dialog}
+      className="tournament-dialog"
+      aria-labelledby="leave-title"
+      onCancel={(event) => {
+        event.preventDefault();
+        keepPlaying();
+      }}
+    >
+      <h2 id="leave-title">Leave unfinished play?</h2>
+      <p>Choose Keep playing to continue this screen.</p>
+      <div className="tournament-actions">
+        <button className="control" ref={keepButton} onClick={keepPlaying}>
+          Keep playing
+        </button>
+        <button className="control" onClick={leavePlay}>
+          Leave
+        </button>
+      </div>
+    </dialog>
+  );
+}
