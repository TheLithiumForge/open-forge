@@ -0,0 +1,112 @@
+import { expect, test } from 'vitest';
+import { createGame } from '../game.ts';
+import { parseJson } from '../saved-format.ts';
+import { encodeSnapshot } from '../snapshot.ts';
+import { importTournament, sortedJson } from './format.ts';
+import { readTournament } from './validate-record.ts';
+
+function file() {
+  return {
+    format: 'neon-pairs/tournament',
+    version: 3,
+    names: ['Al', 'Bo', 'Cy', 'Di'],
+    tournament: {
+      names: ['Al', 'Bo', 'Cy', 'Di'],
+      codes: ['np1-6-1', 'np1-6-2', 'np1-8-3'],
+      results: [],
+    },
+    phase: 'ready',
+    game: null,
+  };
+}
+test('export sorts keys recursively and active snapshots round trip', () => {
+  const value = {
+    ...file(),
+    phase: 'playing',
+    game: parseJson(encodeSnapshot(createGame('np1-6-1'))),
+  };
+  const text = sortedJson(value);
+  const verify = (item: unknown): void => {
+    if (Array.isArray(item)) item.forEach(verify);
+    else if (item && typeof item === 'object') {
+      expect(Object.keys(item)).toEqual(Object.keys(item).sort());
+      Object.values(item).forEach(verify);
+    }
+  };
+  verify(parseJson(text));
+  expect(importTournament(text)).toEqual({ file: value });
+});
+test('imports reject unknown fields at every level with precise messages', () => {
+  const good = file();
+  for (const [field, value] of [
+    ['extra', { ...good, extra: true }],
+    ['extraRecord', { ...good, tournament: { ...good.tournament, extraRecord: true } }],
+    [
+      'extraScore',
+      {
+        ...good,
+        tournament: {
+          ...good.tournament,
+          results: [{ moves: 18, elapsedMs: 1, extraScore: true }],
+        },
+      },
+    ],
+    ['extraGame', { ...good, game: { extraGame: true } }],
+    ['extraSelection', { ...good, game: { selection: { kind: 'closed', extraSelection: true } } }],
+  ])
+    expect(importTournament(JSON.stringify(value))).toEqual({ error: `Unknown field: ${field}.` });
+});
+test('invalid records and inconsistent phases are rejected without modifying the input', () => {
