@@ -0,0 +1,69 @@
+import { formatElapsed } from '../elapsed-time.ts';
+import { bracket } from './rules.ts';
+import type { TournamentRecord } from './types.ts';
+
+export function Bracket({ tournament }: { tournament: TournamentRecord }) {
+  return (
+    <div className="tournament-table">
+      <table>
+        <caption>Tournament bracket</caption>
+        <thead>
+          <tr>
+            {[
+              'Round',
+              'Board code',
+              'Player',
+              'Moves',
+              'Time',
+              'Player',
+              'Moves',
+              'Time',
+              'Winner',
+            ].map((label, i) => (
+              <th scope="col" key={i}>
+                {label}
+              </th>
+            ))}
+          </tr>
+        </thead>
+        <tbody>
+          {bracket(tournament).map((match, i) => (
+            <tr key={i}>
+              <td>{match.round}</td>
+              <td>{match.code}</td>
+              {match.players.map((seed, side) => {
+                const score = match.scores[side];
+                return (
+                  <FragmentCells
+                    key={side}
+                    name={
+                      seed === null
+                        ? 'To be decided'
+                        : `${tournament.names[seed - 1]}${seed === match.winner ? ' (winner)' : ''}`
+                    }
+                    moves={score ? `${score.moves} ${score.moves === 1 ? 'move' : 'moves'}` : '—'}
+                    time={score ? formatElapsed(score.elapsedMs) : '—'}
+                  />
+                );
+              })}
+              <td>
+                {match.winner === null
+                  ? 'To be decided'
+                  : `${tournament.names[match.winner - 1]} (winner)`}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  );
+}
+function FragmentCells({ name, moves, time }: { name: string; moves: string; time: string }) {
+  return (
+    <>
+      <td>{name}</td>
+      <td>{moves}</td>
+      <td>{time}</td>
+    </>
+  );
+}
