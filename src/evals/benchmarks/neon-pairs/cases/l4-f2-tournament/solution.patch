+    JSON.stringify({ ...good, phase: 'playing' }),
+    JSON.stringify({ ...good, phase: 'turn-complete' }),
+    JSON.stringify({ ...good, phase: 'match-complete' }),
+    JSON.stringify({
+      ...good,
