--- /dev/null
+++ b/src/game/tournament/history-storage.ts
@@ -0,0 +1,52 @@
+import { hasExactKeys, isJsonObject, parseJson } from '../saved-format.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import { sortedJson } from './format.ts';
+import { readTournament } from './validate-record.ts';
+import type { TournamentRecord } from './types.ts';
+
+export const TOURNAMENTS_KEY = 'np3:tournaments';
+export const STORAGE_NOTICE = "Progress won't be saved on this device.";
+interface HistoryState {
+  items: TournamentRecord[];
+  blocked: boolean;
+}
+export function readHistory(store: PreferenceStore | null): HistoryState {
+  try {
+    if (!store) return { items: [], blocked: true };
+    const text = store.getItem(TOURNAMENTS_KEY);
+    const value = text ? parseJson(text) : null;
+    if (
+      !isJsonObject(value) ||
+      !hasExactKeys(value, ['v', 'items']) ||
+      value.v !== 3 ||
+      !Array.isArray(value.items) ||
+      value.items.length > 10
+    )
+      return { items: [], blocked: false };
+    try {
+      const items = value.items.map(readTournament);
+      if (items.some((item) => item.results.length !== item.codes.length * 2))
+        return { items: [], blocked: false };
+      return { items, blocked: false };
+    } catch {
+      return { items: [], blocked: false };
+    }
+  } catch {
+    return { items: [], blocked: true };
+  }
+}
+export function saveHistory(
+  store: PreferenceStore | null,
+  items: TournamentRecord[],
+  record: TournamentRecord,
+): HistoryState {
+  const fingerprint = sortedJson(record);
+  const next = [record, ...items.filter((item) => sortedJson(item) !== fingerprint)].slice(0, 10);
+  try {
+    if (!store) throw new Error('No storage');
+    store.setItem(TOURNAMENTS_KEY, JSON.stringify({ v: 3, items: next }));
+    return { items: next, blocked: false };
+  } catch {
+    return { items: next, blocked: true };
+  }
+}
