+import { expect, test } from 'vitest';
+import { readHistory, saveHistory, TOURNAMENTS_KEY } from './history-storage.ts';
+import type { TournamentRecord } from './types.ts';
+
+function record(index: number): TournamentRecord {
+  return {
+    names: [`Player ${index}`, 'Bo', 'Cy', 'Di'],
+    codes: ['np1-6-1', 'np1-6-2', 'np1-8-3'],
+    results: [6, 6, 6, 6, 8, 8].map((size) => ({ moves: size ** 2 / 2, elapsedMs: index })),
+  };
+}
+function memory(text: string | null = null) {
+  const writes: string[] = [];
+  return {
+    writes,
+    getItem: () => text,
+    setItem: (key: string, value: string) => {
+      expect(key).toBe(TOURNAMENTS_KEY);
+      writes.push(value);
+      text = value;
+    },
+  };
+}
+test('history saves exactly the newest ten records in a version three envelope', () => {
+  const store = memory();
+  let items: TournamentRecord[] = [];
+  for (let index = 1; index <= 12; index++) items = saveHistory(store, items, record(index)).items;
+  expect(items.map((item) => item.names[0])).toEqual(
+    Array.from({ length: 10 }, (_, i) => `Player ${12 - i}`),
+  );
+  const stored: unknown = JSON.parse(store.writes.at(-1)!);
+  expect(stored).toEqual({ v: 3, items });
+  expect(readHistory(store)).toEqual({ items, blocked: false });
+});
+test('invalid stored values are empty and untouched until the next save', () => {
+  for (const text of [
+    '{',
+    'null',
+    '{}',
+    JSON.stringify({ v: 2, items: [] }),
+    JSON.stringify({ v: 3, items: [], extra: 1 }),
+    JSON.stringify({ v: 3, items: [{}] }),
+    JSON.stringify({ v: 3, items: [{ ...record(1), results: [] }] }),
+    JSON.stringify({ v: 3, items: Array.from({ length: 11 }, (_, i) => record(i)) }),
+  ]) {
+    const store = memory(text);
+    expect(readHistory(store)).toEqual({ items: [], blocked: false });
+    expect(store.writes).toHaveLength(0);
+    expect(store.getItem()).toBe(text);
+    saveHistory(store, [], record(1));
+    expect(readHistory(store).items).toEqual([record(1)]);
+  }
+});
+test('blocked reads and writes preserve in-memory records', () => {
+  const denied = {
+    getItem(): null {
+      throw new Error('Blocked');
+    },
+    setItem(): void {
+      throw new Error('Blocked');
+    },
+  };
+  expect(readHistory(denied)).toEqual({ items: [], blocked: true });
+  expect(readHistory(null)).toEqual({ items: [], blocked: true });
+  const first = saveHistory(denied, [], record(1));
+  expect(first).toEqual({ items: [record(1)], blocked: true });
+  const second = saveHistory(null, first.items, record(2));
+  expect(second).toEqual({ items: [record(2), record(1)], blocked: true });
+});
diff --git a/src/game/tournament/history-storage.ts b/src/game/tournament/history-storage.ts
new file mode 100644
