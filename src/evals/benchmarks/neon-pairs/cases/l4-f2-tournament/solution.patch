+++ b/src/game/tournament/use-transfer.ts
@@ -0,0 +1,64 @@
+import { isJsonObject, parseJson } from '../saved-format.ts';
+import { importTournament, sortedJson } from './format.ts';
+import { nameError, normalizeName } from './rules.ts';
+import type { TournamentFile, TournamentRecord } from './types.ts';
+import type { useTournament } from './use-tournament.ts';
+
+export function useTransfer(state: ReturnType<typeof useTournament>) {
+  function exportFile(): void {
+    const normalized = state.names.map(normalizeName);
+    const error = nameError(normalized);
+    if (error) {
+      state.setNotice(error);
+      return;
+    }
+    state.setNames(normalized);
+    const game = state.phase === 'playing' ? parseJson(state.controller.exportSnapshot()) : null;
+    const file: TournamentFile = {
+      format: 'neon-pairs/tournament',
+      version: 3,
+      names: normalized,
+      tournament: state.record,
+      phase: state.phase,
+      game: isJsonObject(game) ? game : null,
+    };
+    state.setJson(sortedJson(file));
+    state.setNotice('Tournament exported.');
+  }
+  function apply(file: TournamentFile, save = true): void {
+    if (file.game) {
+      state.controller.loadSnapshot(JSON.stringify(file.game));
+      state.controller.resume();
+    }
+    state.setRecord(file.tournament);
+    state.setNames(file.names);
+    state.setPhase(file.phase);
+    state.setNotice('Tournament loaded.');
+    if (save && file.phase === 'champion' && file.tournament) state.history.save(file.tournament);
+    state.heading.current?.focus();
+  }
+  function load(): void {
+    const result = importTournament(state.json);
+    if ('error' in result) {
+      state.setNotice(result.error);
+      return;
+    }
+    state.guard(() => apply(result.file));
+  }
+  function viewPast(item: TournamentRecord): void {
+    state.guard(() =>
+      apply(
+        {
+          format: 'neon-pairs/tournament',
+          version: 3,
+          names: item.names,
+          tournament: item,
+          phase: 'champion',
+          game: null,
+        },
+        false,
+      ),
+    );
+  }
+  return { exportFile, load, viewPast };
+}
diff --git a/src/game/tournament/validate-record.ts b/src/game/tournament/validate-record.ts
new file mode 100644
index 0000000..5557044
--- /dev/null
+++ b/src/game/tournament/validate-record.ts
@@ -0,0 +1,61 @@
+import { parseBoardCode } from '../deck.ts';
+import { ELAPSED_MAX_MS, MOVES_MAX } from '../game.ts';
+import { hasExactKeys, isJsonObject } from '../saved-format.ts';
+import { nameError, normalizeName, roundSizes } from './rules.ts';
+import type { Score, TournamentRecord } from './types.ts';
+
+export function checkFields(value: Record<string, unknown>, allowed: readonly string[]): void {
+  const unknown = Object.keys(value).find((key) => !allowed.includes(key));
+  if (unknown !== undefined) throw new Error(`Unknown field: ${unknown}.`);
+}
+export function readNames(value: unknown): string[] {
+  if (
+    !Array.isArray(value) ||
+    ![4, 8].includes(value.length) ||
+    !value.every((name): name is string => typeof name === 'string')
+  )
+    throw new Error('Invalid tournament.');
+  const names = value.map(normalizeName);
+  const error = nameError(names);
+  if (error) throw new Error(error);
+  return names;
+}
+export const RECORD_KEYS = ['names', 'codes', 'results'];
+export function readTournament(value: unknown): TournamentRecord {
+  if (!isJsonObject(value)) throw new Error('Invalid tournament.');
+  checkFields(value, RECORD_KEYS);
+  if (!hasExactKeys(value, RECORD_KEYS)) throw new Error('Invalid tournament.');
+  const names = readNames(value.names);
+  const sizes = roundSizes(names.length);
+  const codes = value.codes;
+  if (
+    !Array.isArray(codes) ||
+    codes.length !== sizes.length ||
+    !codes.every((code): code is string => typeof code === 'string') ||
+    !codes.every((code, i) => parseBoardCode(code)?.size === sizes[i]) ||
+    new Set(codes).size !== sizes.length ||
+    !Array.isArray(value.results) ||
+    value.results.length > sizes.length * 2
+  )
+    throw new Error('Invalid tournament.');
+  const results = value.results.map((score: unknown, i: number): Score => {
+    if (!isJsonObject(score)) throw new Error('Invalid tournament.');
+    checkFields(score, ['moves', 'elapsedMs']);
+    const size = sizes[Math.floor(i / 2)];
+    if (
+      !hasExactKeys(score, ['moves', 'elapsedMs']) ||
+      size === undefined ||
+      typeof score.moves !== 'number' ||
+      !Number.isInteger(score.moves) ||
+      score.moves < size ** 2 / 2 ||
+      score.moves > MOVES_MAX ||
+      typeof score.elapsedMs !== 'number' ||
+      !Number.isFinite(score.elapsedMs) ||
+      score.elapsedMs < 0 ||
+      score.elapsedMs > ELAPSED_MAX_MS
+    )
+      throw new Error('Invalid tournament.');
+    return { moves: score.moves, elapsedMs: score.elapsedMs };
+  });
+  return { names, codes, results };
+}
