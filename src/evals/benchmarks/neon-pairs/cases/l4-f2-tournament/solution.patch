@@ -0,0 +1,55 @@
+import type { Match, Score, TournamentRecord } from './types.ts';
+
+const NAME_LENGTH = 'Use 2 to 20 characters.';
+const NAME_REPEAT = 'Each name must be different.';
+export function normalizeName(name: string): string {
+  return name.trim().replace(/\s+/gu, ' ').normalize('NFC');
+}
+export function nameError(names: readonly string[]): string | null {
+  const normalized = names.map(normalizeName);
+  if (normalized.some((name) => [...name].length < 2 || [...name].length > 20)) return NAME_LENGTH;
+  if (new Set(normalized.map((name) => name.toUpperCase().normalize('NFC'))).size !== names.length)
+    return NAME_REPEAT;
+  return null;
+}
+export function roundSizes(count: number): number[] {
+  return count === 8 ? [4, 4, 4, 4, 6, 6, 8] : [6, 6, 8];
+}
+export function winningSeed(players: [number, number], scores: [Score, Score]): number {
+  const [a, b] = scores;
+  if (a.moves !== b.moves) return players[a.moves < b.moves ? 0 : 1];
+  if (a.elapsedMs !== b.elapsedMs) return players[a.elapsedMs < b.elapsedMs ? 0 : 1];
+  return Math.min(...players);
+}
+export function bracket(tournament: TournamentRecord): Match[] {
+  let seeds: (number | null)[] =
+    tournament.names.length === 8 ? [1, 8, 4, 5, 3, 6, 2, 7] : [1, 4, 2, 3];
+  const matches: Match[] = [];
+  while (seeds.length > 1) {
+    const winners: (number | null)[] = [];
+    const size = seeds.length === 8 ? 4 : seeds.length === 4 ? 6 : 8;
+    for (let i = 0; i < seeds.length; i += 2) {
+      const index = matches.length;
+      const players: Match['players'] = [seeds[i] ?? null, seeds[i + 1] ?? null];
+      const scores: Match['scores'] = [
+        tournament.results[index * 2],
+        tournament.results[index * 2 + 1],
+      ];
+      const winner =
+        players[0] !== null && players[1] !== null && scores[0] && scores[1]
+          ? winningSeed([players[0], players[1]], [scores[0], scores[1]])
+          : null;
+      matches.push({
+        round: size === 4 ? 'Quarterfinal' : size === 6 ? 'Semifinal' : 'Final',
+        size,
+        players,
+        scores,
+        winner,
+        code: tournament.codes[index] ?? '',
+      });
+      winners.push(winner);
+    }
+    seeds = winners;
+  }
+  return matches;
+}
