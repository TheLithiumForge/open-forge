diff --git a/src/game/tournament/format.ts b/src/game/tournament/format.ts
new file mode 100644
index 0000000..8d6dfd9
--- /dev/null
+++ b/src/game/tournament/format.ts
@@ -0,0 +1,103 @@
+import { isWon } from '../game.ts';
+import { hasExactKeys, isJsonObject, parseJson } from '../saved-format.ts';
+import { decodeSnapshot, SNAPSHOT_KEYS } from '../snapshot.ts';
+import { checkFields, readNames, readTournament, RECORD_KEYS } from './validate-record.ts';
+import type { Phase, TournamentFile } from './types.ts';
+
+// Stable serialization applies to every object, including nested snapshot selections.
+export function sortedJson(value: unknown): string {
+  return JSON.stringify(
+    value,
+    (_key, item: unknown) =>
+      isJsonObject(item)
+        ? Object.fromEntries(
+            Object.keys(item)
+              .sort()
+              .map((key) => [key, item[key]]),
+          )
+        : item,
+    2,
+  );
+}
+function isPhase(value: unknown): value is Phase {
+  return (
+    value === 'setup' ||
+    value === 'ready' ||
+    value === 'playing' ||
+    value === 'turn-complete' ||
+    value === 'match-complete' ||
+    value === 'champion'
+  );
+}
+const FILE_KEYS = ['format', 'version', 'names', 'tournament', 'phase', 'game'];
+export function importTournament(text: string): { file: TournamentFile } | { error: string } {
+  try {
+    const value = parseJson(text);
+    if (!isJsonObject(value)) throw new Error('Invalid tournament.');
+    checkFields(value, FILE_KEYS);
+    // Unknown fields are checked before semantics, including nested records and snapshots.
+    if (isJsonObject(value.tournament)) {
+      checkFields(value.tournament, RECORD_KEYS);
+      if (Array.isArray(value.tournament.results))
+        for (const score of value.tournament.results)
+          if (isJsonObject(score)) checkFields(score, ['moves', 'elapsedMs']);
+    }
+    if (isJsonObject(value.game)) {
+      checkFields(value.game, SNAPSHOT_KEYS);
+      if (isJsonObject(value.game.selection)) {
+        const keys =
+          value.game.selection.kind === 'closed'
+            ? ['kind']
+            : value.game.selection.kind === 'one'
+              ? ['kind', 'index']
+              : ['kind', 'first', 'second', 'remainingMs'];
+        checkFields(value.game.selection, keys);
+      }
+    }
+    if (
+      !hasExactKeys(value, FILE_KEYS) ||
+      value.format !== 'neon-pairs/tournament' ||
+      value.version !== 3 ||
+      !isPhase(value.phase)
+    )
+      throw new Error('Invalid tournament.');
+    const names = readNames(value.names);
+    const tournament = value.tournament === null ? null : readTournament(value.tournament);
+    const phase = value.phase;
+    if (!tournament) {
+      if (phase !== 'setup' || value.game !== null) throw new Error('Invalid tournament.');
+    } else {
+      if (JSON.stringify(names) !== JSON.stringify(tournament.names))
+        throw new Error('Invalid tournament.');
+      const n = tournament.results.length;
+      const complete = n === tournament.codes.length * 2;
+      if (
+        complete
+          ? phase !== 'champion'
+          : !(
+              ['ready', 'playing'].includes(phase) ||
+              (phase === 'turn-complete' && n % 2 === 1) ||
+              (phase === 'match-complete' && n > 0 && n % 2 === 0)
+            )
+      )
+        throw new Error('Invalid tournament.');
+      if (phase === 'playing') {
+        const game = decodeSnapshot(JSON.stringify(value.game));
+        if (!game || isWon(game) || game.boardCode !== tournament.codes[Math.floor(n / 2)])
+          throw new Error('Invalid tournament.');
+      } else if (value.game !== null) throw new Error('Invalid tournament.');
+    }
+    return {
+      file: {
+        format: 'neon-pairs/tournament',
+        version: 3,
+        names,
+        tournament,
+        phase,
+        game: isJsonObject(value.game) ? value.game : null,
+      },
+    };
+  } catch (error) {
+    return { error: error instanceof Error ? error.message : 'Invalid tournament.' };
+  }
+}
