+import { expect, test } from 'vitest';
+import { boardCode } from '../deck.ts';
+import { bracket, nameError, normalizeName, roundSizes, winningSeed } from './rules.ts';
+import type { TournamentRecord } from './types.ts';
+
+function record(count = 4): TournamentRecord {
+  return {
+    names: Array.from({ length: count }, (_, i) => `Player ${i + 1}`),
+    codes: roundSizes(count).map((size, i) => boardCode(size, i + 1)),
+    results: [],
+  };
+}
+test('normalization, Unicode code-point limits and case-insensitive distinct names', () => {
+  expect(normalizeName('  E\u0301va\t \n Jones  ')).toBe('Éva Jones');
+  expect(nameError(['  ÉVA Jones ', 'E\u0301va\tJones', 'Al', 'Bo'])).toBe(
+    'Each name must be different.',
+  );
+  expect(nameError(['Straße', 'STRASSE'])).toBe('Each name must be different.');
+  expect(nameError(['a', 'Bo'])).toBe('Use 2 to 20 characters.');
+  expect(nameError(['😀'.repeat(20), 'Bo'])).toBeNull();
+  expect(nameError(['😀'.repeat(21), 'Bo'])).toBe('Use 2 to 20 characters.');
+  expect(nameError(['  ', 'Bo'])).toBe('Use 2 to 20 characters.');
+});
+test('brackets use exact seed order, round names and board sizes', () => {
+  const four = bracket(record());
+  expect(four.map((match) => match.players)).toEqual([
+    [1, 4],
+    [2, 3],
+    [null, null],
+  ]);
+  expect(four.map((match) => [match.round, match.size])).toEqual([
+    ['Semifinal', 6],
+    ['Semifinal', 6],
+    ['Final', 8],
+  ]);
+  const eight = bracket(record(8));
+  expect(eight.slice(0, 4).map((match) => match.players)).toEqual([
+    [1, 8],
+    [4, 5],
+    [3, 6],
+    [2, 7],
+  ]);
+  expect(eight.map((match) => match.size)).toEqual([4, 4, 4, 4, 6, 6, 8]);
+  expect(eight.slice(0, 4).every((match) => match.round === 'Quarterfinal')).toBe(true);
+});
+test('lower moves, then exact active time, then higher seed decide winners', () => {
+  expect(
+    winningSeed(
+      [4, 1],
+      [
+        { moves: 18, elapsedMs: 999 },
+        { moves: 19, elapsedMs: 1 },
+      ],
+    ),
+  ).toBe(4);
+  expect(
+    winningSeed(
+      [4, 1],
+      [
+        { moves: 18, elapsedMs: 2.25 },
+        { moves: 18, elapsedMs: 2.5 },
+      ],
+    ),
+  ).toBe(4);
+  expect(
+    winningSeed(
+      [4, 1],
+      [
+        { moves: 18, elapsedMs: 2 },
+        { moves: 18, elapsedMs: 2 },
+      ],
+    ),
+  ).toBe(1);
+});
+for (const count of [4, 8]) {
+  test(`all ${count}-player winners advance to the correct next match and champion`, () => {
+    const tournament = record(count);
+    for (const size of roundSizes(count))
+      tournament.results.push(
+        { moves: size ** 2 / 2 + 1, elapsedMs: 1 },
+        { moves: size ** 2 / 2, elapsedMs: 2 },
+      );
+    const matches = bracket(tournament);
+    expect(matches.every((match) => match.winner === match.players[1])).toBe(true);
+    expect(matches.at(-1)?.winner).toBe(count === 4 ? 3 : 7);
+  });
+}
