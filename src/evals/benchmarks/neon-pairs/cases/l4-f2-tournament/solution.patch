+import { useState } from 'react';
+import { browserStore } from '../session/use-saved-preferences.ts';
+import { readHistory, saveHistory } from './history-storage.ts';
+import type { TournamentRecord } from './types.ts';
+
+export function useHistory() {
+  const [store] = useState(browserStore);
+  const [state, setState] = useState(() => readHistory(store));
+  function save(record: TournamentRecord): void {
+    setState(saveHistory(store, state.items, record));
+  }
+  return { ...state, save };
+}
