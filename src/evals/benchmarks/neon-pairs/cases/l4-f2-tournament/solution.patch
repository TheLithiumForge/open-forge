+import { useEffect, useLayoutEffect, useRef, useState } from 'react';
+import { isWon } from '../game.ts';
+import { formatElapsed } from '../elapsed-time.ts';
+import { freshBoardCode } from '../session/fresh-board.ts';
+import { useGame } from '../session/use-game.ts';
+import { bracket, nameError, normalizeName, roundSizes } from './rules.ts';
+import type { Phase, TournamentRecord } from './types.ts';
+import { useHistory } from './use-history.ts';
+
+interface Props {
+  open: boolean;
+  close(): void;
+  announce(lines: string[]): void;
+}
+export function useTournament({ open, close, announce }: Props) {
+  const history = useHistory();
+  const [names, setNames] = useState<string[]>(Array(4).fill(''));
+  const [record, setRecord] = useState<TournamentRecord | null>(null);
+  const [phase, setPhase] = useState<Phase>('setup');
+  const [json, setJson] = useState('');
+  const [notice, setNotice] = useState('');
+  const [pending, setPending] = useState<(() => void) | null>(null);
+  const heading = useRef<HTMLHeadingElement>(null);
+  const returnFocus = useRef<HTMLElement | null>(null);
+  const controller = useGame({ persist: false, enabled: open && phase === 'playing' && !pending });
+  const game = controller.session.game;
+  const matches = record ? bracket(record) : [];
+  const completed = record?.results.length ?? 0;
+  const match = matches[Math.floor(completed / 2)];
+  const player = match?.players[completed % 2];
+  const champion = matches.at(-1)?.winner;
+  const championName = champion ? record?.names[champion - 1] : '';
+  useLayoutEffect(() => {
+    if (open) heading.current?.focus();
+  }, [open, phase, completed, record?.codes]);
+  const round = match?.round ?? '';
+  const playerName = player ? record?.names[player - 1] : '';
+  const feedback = phase === 'playing' ? controller.session.feedback : '';
+  useEffect(() => {
+    if (!open) return;
+    const last = record?.results.at(-1);
+    const finished =
+      last && (phase === 'turn-complete' || phase === 'match-complete')
+        ? `Turn finished: ${last.moves} ${last.moves === 1 ? 'move' : 'moves'} and ${formatElapsed(last.elapsedMs)}.`
+        : '';
+    announce(
+      phase === 'champion'
+        ? [`Champion: ${championName}`, notice]
+        : phase === 'setup'
+          ? [notice]
+          : [`Round: ${round}`, `Now playing: ${playerName}`, finished, feedback, notice],
+    );
+  }, [open, phase, round, playerName, championName, feedback, notice, announce, record]);
+  useEffect(() => {
+    if (!open || phase !== 'playing' || !record || !isWon(game)) return;
+    const next = {
+      ...record,
+      results: [...record.results, { moves: game.moves, elapsedMs: game.elapsedMs }],
+    };
+    setRecord(next);
+    if (next.results.length === next.codes.length * 2) {
+      history.save(next);
+      setPhase('champion');
+    } else setPhase(next.results.length % 2 === 1 ? 'turn-complete' : 'match-complete');
+  }, [open, phase, game, record, history]);
+  function guard(action: () => void): void {
+    if (
+      (record && phase !== 'champion') ||
+      (phase === 'setup' && names.some((name) => name.trim()))
+    ) {
+      returnFocus.current =
+        document.activeElement instanceof HTMLElement ? document.activeElement : null;
+      setPending(() => action);
+    } else action();
+  }
+  function keep(): void {
+    setPending(null);
+    returnFocus.current?.focus();
+  }
+  function back(): void {
+    setRecord(null);
+    setPhase('setup');
+    setNotice('');
+    setNames(Array(4).fill(''));
+    close();
+  }
+  function start(): void {
+    const normalized = names.map(normalizeName);
+    setNames(normalized);
+    const error = nameError(normalized);
+    if (error) {
+      setNotice(error);
+      return;
+    }
+    const codes: string[] = [];
+    for (const size of roundSizes(normalized.length)) {
+      let code: string;
+      do {
+        code = freshBoardCode(size);
+      } while (codes.includes(code));
+      codes.push(code);
+    }
+    setRecord({ names: normalized, codes, results: [] });
+    setPhase('ready');
+    setNotice('');
+  }
+  function startTurn(): void {
+    if (!match) return;
+    controller.loadBoard(match.code);
+    setPhase('playing');
+    setNotice('');
+  }
+  function next(): void {
+    setPhase('ready');
+    setNotice('');
+  }
+  return {
+    names,
+    setNames,
+    record,
+    setRecord,
+    phase,
+    setPhase,
+    json,
+    setJson,
+    notice,
+    setNotice,
+    pending,
+    setPending,
+    heading,
+    controller,
+    game,
+    championName,
+    history,
+    guard,
+    keep,
+    back,
+    start,
+    startTurn,
+    next,
+  };
+}
