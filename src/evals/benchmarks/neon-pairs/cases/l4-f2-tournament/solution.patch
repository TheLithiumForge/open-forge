@@ -0,0 +1,22 @@
+import { expect } from './browser-test.ts';
+import { importTournament } from '../src/game/tournament/format.ts';
+import type { Page } from '@playwright/test';
+
+export async function roundTripTurn(page: Page, partner: number): Promise<void> {
+  await page.getByRole('button', { name: 'Export tournament', exact: true }).click();
+  const text = await page.getByLabel('Tournament JSON', { exact: true }).inputValue();
+  const parsed = importTournament(text);
+  if ('error' in parsed) throw new Error(parsed.error);
+  expect(parsed.file.phase).toBe('playing');
+  expect(parsed.file.game?.elapsedMs).toBe(1000);
+  await page.locator('.card').nth(partner).click();
+  await expect(page.locator('.card.matched')).toHaveCount(2);
+  await page.getByRole('button', { name: 'Load tournament', exact: true }).click();
+  await expect(page.getByRole('button', { name: 'Keep playing', exact: true })).toBeFocused();
+  await page.getByRole('button', { name: 'Leave', exact: true }).click();
+  await expect(page.getByRole('heading', { name: 'Tournament', exact: true })).toBeFocused();
+  await expect(page.locator('.card.revealed')).toHaveCount(1);
+  await expect(page.locator('.card.matched')).toHaveCount(0);
+  await expect(page.getByRole('status')).toContainText('Now playing: Éva One');
+  await expect(page.getByRole('status')).toContainText('Tournament loaded.');
+}
diff --git a/tests/tournament.e2e.test.ts b/tests/tournament.e2e.test.ts
new file mode 100644
index 0000000..fb354b4
--- /dev/null
+++ b/tests/tournament.e2e.test.ts
@@ -0,0 +1,175 @@
+import { expect, test, TestTimeouts } from './browser-test.ts';
+import { specDeal } from './deal-oracle.ts';
+import { roundTripTurn } from './tournament-transfer.ts';
+import { TOURNAMENTS_KEY } from '../src/game/tournament/history-storage.ts';
+import { PREFERENCES_KEY } from '../src/game/session/storage.ts';
+import assert from 'node:assert/strict';
+import { importTournament } from '../src/game/tournament/format.ts';
+import { isJsonObject } from '../src/game/saved-format.ts';
+
+// Both complete brackets are played through real card controls. Only public board codes
+// feed the independent deal oracle; no hidden faces or React internals are inspected.
+test(
+  'plays four and eight player tournaments, preserves preferences and reloads history',
+  async ({ page, gameURL, browser }, artifacts) => {
+    await page.setViewportSize({ width: 390, height: 844 });
+    await page.clock.install({ time: 0 });
+    await page.goto(gameURL);
+    await page.clock.pauseAt(10000);
+    await page.getByLabel('Grid size', { exact: true }).selectOption('10');
+    const originalPreferences = await page.evaluate(
+      (key) => localStorage.getItem(key),
+      PREFERENCES_KEY,
+    );
+    const button = (name: string) => page.getByRole('button', { name, exact: true });
+    await button('Tournament').click();
+    await expect(page.getByRole('heading', { name: 'Tournament', exact: true })).toBeFocused();
+    await expect(page.getByRole('status')).toHaveCount(1);
+    await button('Start tournament').click();
+    await expect(page.getByRole('status')).toHaveText('Use 2 to 20 characters.');
+    for (let i = 1; i <= 4; i++)
+      await page.getByLabel(`Player ${i}`, { exact: true }).fill(i <= 2 ? 'Repeat' : `Name ${i}`);
+    await button('Start tournament').click();
+    await expect(page.getByRole('status')).toHaveText('Each name must be different.');
+
+    for (const count of [4, 8]) {
+      await page.getByLabel('Players', { exact: true }).selectOption(String(count));
+      for (let i = 1; i <= count; i++)
+        await page
+          .getByLabel(`Player ${i}`, { exact: true })
+          .fill(i === 1 ? '  E\u0301va   One  ' : `Name ${i}`);
+      for (const control of await page
+        .locator('.tournament button, .tournament select, .tournament input, .tournament textarea')
+        .all()) {
+        const bounds = await control.boundingBox();
+        expect(bounds?.width).toBeGreaterThanOrEqual(44);
+        expect(bounds?.height).toBeGreaterThanOrEqual(44);
+      }
+      await button('Start tournament').click();
+      await expect(page.getByRole('status')).toContainText('Now playing: Éva One');
+      await expect(page.locator('table caption')).toHaveText('Tournament bracket');
+      await expect(page.locator('table thead th:not([scope="col"])')).toHaveCount(0);
+      await button('Export tournament').click();
+      const draft = await page.getByLabel('Tournament JSON', { exact: true }).inputValue();
+      const parsed = importTournament(draft);
+      assert.ok('file' in parsed);
+      const exported = parsed.file;
+      expect(exported.tournament?.codes.length).toBe(count - 1);
+      expect(new Set(exported.tournament?.codes).size).toBe(count - 1);
+      await page
+        .getByLabel('Tournament JSON', { exact: true })
+        .fill(JSON.stringify({ ...exported, strange: true }));
+      await button('Load tournament').click();
+      await expect(page.getByRole('status')).toContainText('Unknown field: strange.');
+      await expect(button('Start turn')).toBeVisible();
+      await button('Leave tournament').click();
+      await expect(page.getByRole('dialog')).toBeVisible();
+      await expect(button('Keep playing')).toBeFocused();
+      await page.keyboard.press('Escape');
+      await expect(page.getByRole('dialog')).toHaveCount(0);
+      await expect(button('Leave tournament')).toBeFocused();
+
+      const codes = exported.tournament!.codes;
+      for (let match = 0; match < codes.length; match++) {
+        const code = codes[match]!;
+        const [, sizeText, seedText] = code.split('-');
+        const size = Number(sizeText);
+        const deal = specDeal(size, Number(seedText));
+        const pairs = Array.from({ length: size ** 2 / 2 }, (_, face) =>
+          deal.flatMap((item, index) => (item === face ? [index] : [])),
+        );
+        for (let side = 0; side < 2; side++) {
+          await button('Start turn').click();
+          await expect(page.locator('.card')).toHaveCount(size ** 2);
+          await expect(page.getByRole('status')).toContainText(
+            `Round: ${size === 4 ? 'Quarterfinal' : size === 6 ? 'Semifinal' : 'Final'}`,
+          );
+          // Different active times make the winner deterministic while moves stay equal.
+          await page.locator('.card').nth(pairs[0]![0]!).click();
+          await page.clock.runFor(side === 0 ? 1000 : 2000);
+          if (count === 4 && match === 0 && side === 0) await roundTripTurn(page, pairs[0]![1]!);
+          await page.locator('.card').nth(pairs[0]![1]!).click();
+          for (const pair of pairs.slice(1))
+            for (const index of pair) await page.locator('.card').nth(index).click();
+          if (side === 0) {
+            await expect(button('Next turn')).toBeVisible();
+            await button('Next turn').click();
+          } else if (match < codes.length - 1) {
+            await expect(button('Next match')).toBeVisible();
+            await button('Next match').click();
+          }
+        }
+      }
+      await expect(
+        page.getByRole('heading', { name: 'Tournament complete', exact: true }),
+      ).toBeFocused();
+      await expect(page.locator('tbody tr').last()).toContainText('Éva One (winner)');
+      await page.screenshot({
+        path: artifacts.outputPath(`champion-${count}.png`),
+        fullPage: true,
+      });
+      await button('Export tournament').click();
+      const finalJson = await page.getByLabel('Tournament JSON', { exact: true }).inputValue();
+      const parsedFinal = importTournament(finalJson);
+      assert.ok('file' in parsedFinal);
+      const final = parsedFinal.file;
+      expect(final.phase).toBe('champion');
+      expect(final.tournament?.results).toHaveLength((count - 1) * 2);
+      await button('Back to game').click();
+      await expect(page.getByRole('heading', { name: 'Game', exact: true })).toBeFocused();
+      await expect(page.getByLabel('Grid size', { exact: true })).toHaveValue('10');
+      expect(await page.evaluate((key) => localStorage.getItem(key), PREFERENCES_KEY)).toBe(
+        originalPreferences,
+      );
+      await page.reload();
+      await button('Tournament').click();
+      await expect(
+        page.getByRole('button', { name: `${count} players · Champion: Éva One`, exact: true }),
+      ).toBeVisible();
+      const saved: unknown = await page.evaluate(
+        (key) => JSON.parse(localStorage.getItem(key)!),
+        TOURNAMENTS_KEY,
+      );
+      assert.ok(isJsonObject(saved));
+      expect(Object.keys(saved).sort()).toEqual(['items', 'v']);
+      expect(saved.v).toBe(3);
+      expect(saved.items).toHaveLength(count === 4 ? 1 : 2);
+      if (count === 8) {
+        await page.getByLabel('Tournament JSON', { exact: true }).fill(finalJson);
+        await button('Load tournament').click();
+        await expect(
+          page.getByRole('heading', { name: 'Tournament complete', exact: true }),
+        ).toBeFocused();
+      }
+    }
+
+    const context = await browser.newContext();
+    try {
+      const blocked = await context.newPage();
+      await blocked.addInitScript(() => {
+        Object.defineProperty(window, 'localStorage', {
+          get() {
+            throw new Error('Blocked');
+          },
+        });
+      });
+      await blocked.goto(gameURL);
+      await blocked.getByRole('button', { name: 'Tournament', exact: true }).click();
+      await expect(
+        blocked.getByText("Progress won't be saved on this device.", { exact: true }),
+      ).toBeVisible();
+      for (let i = 1; i <= 4; i++)
+        await blocked.getByLabel(`Player ${i}`, { exact: true }).fill(`Name ${i}`);
+      await blocked.getByRole('button', { name: 'Start tournament', exact: true }).click();
+      await expect(blocked.getByRole('button', { name: 'Start turn', exact: true })).toBeVisible();
+      await blocked.getByRole('button', { name: 'Leave tournament', exact: true }).click();
+      await blocked.getByRole('button', { name: 'Leave', exact: true }).click();
+      await expect(blocked.getByRole('button', { name: 'Tournament', exact: true })).toBeVisible();
+    } finally {
+      await context.close();
+    }
+  },
+  { reducedMotion: 'reduce' },
+  undefined,
+  TestTimeouts.long * 3,
+);
