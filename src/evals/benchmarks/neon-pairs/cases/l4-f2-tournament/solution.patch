@@ -0,0 +1,113 @@
+import { useRef } from 'react';
+import { Board } from '../board/Board.tsx';
+import type { BoardFocus } from '../board/Board.tsx';
+import { formatElapsed } from '../elapsed-time.ts';
+import { Bracket } from './Bracket.tsx';
+import { History } from './History.tsx';
+import { LeaveDialog } from './LeaveDialog.tsx';
+import { Setup } from './Setup.tsx';
+import { useTournament } from './use-tournament.ts';
+import { useTransfer } from './use-transfer.ts';
+import './tournament.css';
+
+interface Props {
+  open: boolean;
+  close(): void;
+  announce(lines: string[]): void;
+}
+export function Tournament(props: Props) {
+  const state = useTournament(props);
+  const transfer = useTransfer(state);
+  const board = useRef<BoardFocus>(null);
+  const { phase, record, game, controller } = state;
+  if (!props.open) return null;
+  return (
+    <section className="tournament" aria-labelledby="tournament-title">
+      <h2 id="tournament-title" tabIndex={-1} ref={state.heading}>
+        {phase === 'champion' ? 'Tournament complete' : 'Tournament'}
+      </h2>
+      {phase === 'setup' && (
+        <Setup names={state.names} setNames={state.setNames} start={state.start} />
+      )}
+      {phase === 'ready' && (
+        <button className="control" onClick={state.startTurn}>
+          Start turn
+        </button>
+      )}
+      {phase === 'playing' && (
+        <>
+          <p>
+            {game.moves} {game.moves === 1 ? 'move' : 'moves'} · {formatElapsed(game.elapsedMs)} ·
+            Board code: {game.boardCode}
+          </p>
+          <p id="board-help" className="help">
+            Use a pointer or Tab to enter the board. Arrow keys move between cards. Enter or Space
+            reveals a card.
+          </p>
+          <Board
+            key={controller.session.generation}
+            game={game}
+            activate={controller.activate}
+            ref={board}
+          />
+        </>
+      )}
+      {(phase === 'turn-complete' || phase === 'match-complete') && (
+        <>
+          <p>
+            Turn finished: {record?.results.at(-1)?.moves} moves ·{' '}
+            {formatElapsed(record?.results.at(-1)?.elapsedMs ?? 0)}
+          </p>
+          <button className="control" onClick={state.next}>
+            {phase === 'turn-complete' ? 'Next turn' : 'Next match'}
+          </button>
+        </>
+      )}
+      {record && <Bracket tournament={record} />}
+      <div className="tournament-actions">
+        {phase === 'champion' ? (
+          <button className="control" onClick={state.back}>
+            Back to game
+          </button>
+        ) : (
+          <button className="control" onClick={() => state.guard(state.back)}>
+            Leave tournament
+          </button>
+        )}
+      </div>
+      <div className="tournament-transfer">
+        <label htmlFor="tournament-json">Tournament JSON</label>
+        <textarea
+          className="control"
+          id="tournament-json"
+          rows={6}
+          value={state.json}
+          onChange={(event) => state.setJson(event.currentTarget.value)}
+        />
+        <div className="tournament-actions">
+          <button className="control" onClick={transfer.exportFile}>
+            Export tournament
+          </button>
+          <button className="control" onClick={transfer.load}>
+            Load tournament
+          </button>
+        </div>
+      </div>
+      <History
+        items={state.history.items}
+        blocked={state.history.blocked}
+        view={transfer.viewPast}
+      />
+      {state.pending && (
+        <LeaveDialog
+          keep={state.keep}
+          leave={() => {
+            const action = state.pending;
+            state.setPending(null);
+            action?.();
+          }}
+        />
+      )}
+    </section>
+  );
+}
