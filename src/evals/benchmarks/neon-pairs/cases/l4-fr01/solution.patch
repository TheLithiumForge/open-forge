new file mode 100644
index 0000000..58da392
--- /dev/null
+++ b/src/game/deal-name.test.ts
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { createGame, activateCard, advanceGame } from './game.ts';
+import { validDealName, withDealName, DEAL_NAME_MAX_LENGTH } from './deal-name.ts';
+import { encodeSnapshot, decodeSnapshot, NAMED_SNAPSHOT_VERSION } from './snapshot.ts';
+import { EXAMPLE_CODE } from './game.fixture.ts';
+
+test('names preserve the pending game and round trip only through the named format', () => {
+  const game = advanceGame(activateCard(activateCard(createGame(EXAMPLE_CODE), 0), 1), 175);
+  const named = withDealName(game, 'Café');
+  assert.equal(named.selection, game.selection);
+  assert.equal(named.elapsedMs, game.elapsedMs);
+  assert.equal(JSON.parse(encodeSnapshot(named)).version, NAMED_SNAPSHOT_VERSION);
+  assert.deepEqual(decodeSnapshot(encodeSnapshot(named)), named);
+  assert.deepEqual(withDealName(named, ''), game);
+});
+test('names enforce the stated code unit limit without trimming', () => {
+  assert.equal(validDealName(' '.repeat(DEAL_NAME_MAX_LENGTH)), true);
+  assert.equal(validDealName('x'.repeat(DEAL_NAME_MAX_LENGTH + 1)), false);
+  assert.equal(validDealName('a\nb'), false);
+  assert.equal(validDealName(null), false);
+  const game = createGame(EXAMPLE_CODE);
+  assert.equal(withDealName(game, 'x'.repeat(DEAL_NAME_MAX_LENGTH + 1)), game);
+});
diff --git a/src/game/deal-name.ts b/src/game/deal-name.ts
new file mode 100644
index 0000000..bbc2264
--- /dev/null
+++ b/src/game/deal-name.ts
@@ -0,0 +1,13 @@
+import type { GameState } from './game.types.ts';
+
+export const DEAL_NAME_MAX_LENGTH = 40;
+export function validDealName(value: unknown): value is string {
+  return typeof value === 'string' && value.length <= DEAL_NAME_MAX_LENGTH && !/[\r\n]/.test(value);
+}
+export function withDealName(game: GameState, name: string): GameState {
+  if (!validDealName(name)) return game;
+  const next = { ...game };
+  delete next.name;
+  if (name) next.name = name;
+  return next;
+}
