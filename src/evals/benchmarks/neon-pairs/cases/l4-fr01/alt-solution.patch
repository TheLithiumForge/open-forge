@@ -0,0 +1,13 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { createGame, activateCard } from './game.ts';
+import { encodeSnapshot, decodeSnapshot } from './snapshot.ts';
+import { EXAMPLE_CODE } from './game.fixture.ts';
+
+test('copied snapshots keep progress when members move', () => {
+  const game = activateCard(createGame(EXAMPLE_CODE), 2);
+  const value = JSON.parse(encodeSnapshot(game));
+  const { selection, ...rest } = value;
+  assert.deepEqual(decodeSnapshot(JSON.stringify({ selection, ...rest })), game);
+  assert.equal(decodeSnapshot(JSON.stringify({ selection, ...rest, unknown: true })), null);
+});
diff --git a/src/game/snapshot-name.ts b/src/game/snapshot-name.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c6285581eae0bbf7d9d0af50adc23fb84233bfcd
--- /dev/null
+++ b/src/game/snapshot-name.ts
@@ -0,0 +1,13 @@
+import type { GameState } from './game.ts';
+
+export const DEAL_NAME_MAX_LENGTH = 40;
+export function isValidDealName(value: unknown): value is string {
+  return typeof value === 'string' && value.length <= DEAL_NAME_MAX_LENGTH && !/[\r\n]/.test(value);
+}
+export function withDealName(game: GameState, name: string): GameState {
+  if (!isValidDealName(name)) return game;
+  const next = { ...game };
+  delete next.name;
+  if (name) next.name = name;
+  return next;
+}
diff --git a/src/game/snapshot-names.test.ts b/src/game/snapshot-names.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5cd0fb367b72ac102c50a4c2954f458b930aee62
--- /dev/null
+++ b/src/game/snapshot-names.test.ts
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { createGame, activateCard, advanceGame } from './game.ts';
+import { isValidDealName, withDealName, DEAL_NAME_MAX_LENGTH } from './snapshot-name.ts';
+import { encodeSnapshot, decodeSnapshot, NAMED_SNAPSHOT_VERSION } from './snapshot.ts';
+import { EXAMPLE_CODE } from './game.fixture.ts';
+
+test('names preserve the pending game and round trip only through the named format', () => {
+  const game = advanceGame(activateCard(activateCard(createGame(EXAMPLE_CODE), 0), 1), 175);
+  const named = withDealName(game, 'Café');
+  assert.equal(named.selection, game.selection);
+  assert.equal(named.elapsedMs, game.elapsedMs);
+  assert.equal(JSON.parse(encodeSnapshot(named)).version, NAMED_SNAPSHOT_VERSION);
+  assert.deepEqual(decodeSnapshot(encodeSnapshot(named)), named);
+  assert.deepEqual(withDealName(named, ''), game);
+});
+test('names enforce the stated code unit limit without trimming', () => {
+  assert.equal(isValidDealName(' '.repeat(DEAL_NAME_MAX_LENGTH)), true);
+  assert.equal(isValidDealName('x'.repeat(DEAL_NAME_MAX_LENGTH + 1)), false);
+  assert.equal(isValidDealName('a\nb'), false);
+  assert.equal(isValidDealName(null), false);
+  const game = createGame(EXAMPLE_CODE);
+  assert.equal(withDealName(game, 'x'.repeat(DEAL_NAME_MAX_LENGTH + 1)), game);
+});
