+import type { GameState } from '../game.ts';
+import { DEAL_NAME_MAX_LENGTH } from '../snapshot-name.ts';
+import { ReproductionControl } from './control-labels.ts';
+import './control.css';
+
+export function SnapshotName({ game, rename }: { game: GameState; rename(name: string): void }) {
+  return (
+    <label>
+      {ReproductionControl.name}
+      <input
+        className="control"
+        value={game.name ?? ''}
+        onChange={(event) => rename(event.currentTarget.value.slice(0, DEAL_NAME_MAX_LENGTH))}
+      />
+    </label>
+  );
+}
