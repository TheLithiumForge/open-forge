@@ -0,0 +1,5 @@
+export function snapshotFields(value: Record<string, unknown>, fields: readonly string[]): boolean {
+  const remaining = new Set(fields);
+  for (const field of Object.keys(value)) if (!remaining.delete(field)) return false;
+  return remaining.size === 0;
+}
