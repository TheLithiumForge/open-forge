@@ -0,0 +1,13 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { createGame, activateCard } from './game.ts';
+import { encodeSnapshot, decodeSnapshot } from './snapshot.ts';
+import { EXAMPLE_CODE } from './game.fixture.ts';
+
+test('copied snapshots keep progress when members move', () => {
+  const game = activateCard(createGame(EXAMPLE_CODE), 2);
+  const value = JSON.parse(encodeSnapshot(game));
+  const { selection, ...rest } = value;
+  assert.deepEqual(decodeSnapshot(JSON.stringify({ selection, ...rest })), game);
+  assert.equal(decodeSnapshot(JSON.stringify({ selection, ...rest, unknown: true })), null);
+});
