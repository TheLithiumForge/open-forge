{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "cliVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "layer": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4
          },
          "createdAt": {
            "type": "string"
          },
          "implementers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "effort": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "tool",
                "model",
                "effort"
              ],
              "additionalProperties": false
            }
          },
          "judges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "effort": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "tool",
                "model",
                "effort"
              ],
              "additionalProperties": false
            }
          },
          "gradingVersions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "checker": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rubric": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "judge": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "spec": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "specVersion": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "checker",
                "rubric",
                "judge"
              ],
              "additionalProperties": false
            }
          },
          "path": {
            "type": "string",
            "pattern": "^versions/[A-Za-z0-9][A-Za-z0-9_.-]*/batches/[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "required": [
          "id",
          "cliVersion",
          "layer",
          "createdAt",
          "implementers",
          "judges",
          "gradingVersions",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "batches"
  ],
  "additionalProperties": false
}
