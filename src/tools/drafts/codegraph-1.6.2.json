  "registrationDraft": {
    "mode": "tool-installer-with-command-rewrites",
    "serverName": "codegraph",
    "launcher": "target-entry",
    "execPrefix": ["tool", "exec", "codegraph"],
    "execDelimiter": "optional",
    "commandResolver": "open-forge on PATH when available, otherwise the absolute path of the running open-forge executable",
    "rewrites": [
      {
        "path": ".mcp.json",
        "selector": "/mcpServers/codegraph",
        "format": "json-members",
        "expected": {
          "type": "stdio",
          "command": "codegraph",
          "args": ["serve", "--mcp"],
          "alwaysLoad": true
        },
        "replace": ["command", "args"],
        "args": ["tool", "exec", "codegraph", "serve", "--mcp"]
      },
      {
        "path": ".codex/config.toml",
        "selector": "mcp_servers.codegraph",
        "format": "exact-table-lines",
        "expected": ["[mcp_servers.codegraph]", "command = \"codegraph\"", "args = [\"serve\", \"--mcp\"]"],
        "replace": ["command", "args"],
        "args": ["tool", "exec", "codegraph", "serve", "--mcp"]
      },
      {
        "path": ".claude/settings.json",
        "selector": "hooks.UserPromptSubmit[].hooks[].command",
        "format": "json-members",
        "expected": ["codegraph.cmd prompt-hook", "codegraph prompt-hook"],
        "replace": ["command"],
        "suffix": "tool exec codegraph prompt-hook",
        "removalMatch": "codegraph prompt-hook",
        "expectedHook": {
          "hooks": [
            {
              "type": "command",
              "command": "codegraph.cmd prompt-hook"
            }
          ]
        }
      },
      {
        "paths": [".claude/CLAUDE.md", "AGENTS.md"],
        "format": "marked-shell-line",
        "start": "<!-- CODEGRAPH_START -->",
        "end": "<!-- CODEGRAPH_END -->",
        "expected": "codegraph explore \"<symbol names or question>\"",
        "replacementSuffix": "tool exec codegraph explore \"<symbol names or question>\""
      }
    ],
    "promptHook": {
      "setting": "promptHook",
      "option": "--prompt-hook",
      "values": ["yes", "no"],
      "default": "yes",
      "event": "UserPromptSubmit",
      "explanation": "On structural prompts, adds context from the local index. Nothing leaves the machine. CODEGRAPH_NO_PROMPT_HOOK=1 disables it.",
      "optOut": "Remove only matching CodeGraph prompt-hook commands and prune empty containers, as upstream removePromptHookEntry does."
    },
    "telemetry": {
      "setting": "telemetryEnabled",
      "default": false,
      "offArgs": ["telemetry", "off"],
      "onArgs": ["telemetry", "on"],
      "accountPath": "~/.codegraph/telemetry.json"
    },
    "managedRoleLine": "Code navigation: CodeGraph is active. Use `codegraph_explore` or `open-forge tool exec codegraph explore \"<question>\"` before grep, see the open-forge-codegraph Skill.",
    "backups": "git-or-sibling-bak",
    "onUnexpectedShape": "stop-and-report",
    "after": ["install", "configure", "update"],
    "trustNotes": [
      "Upstream needs an installer option to set the launch command or write the absolute launcher path when it is not on PATH. That would remove Open Forge command rewrites.",
      "Upstream needs --no-prompt-hook for non-interactive installs. --no-permissions only suppresses Claude permissions.",
      "C# call recall was 41% in the trial. Confirm call sites in source.",
      "The Claude instruction destination is .claude/CLAUDE.md, as pinned source specifies. Entry names and CODEGRAPH markers stay unchanged for native removal.",
      "The telemetry command persists an account preference. Suppress telemetry before all other invocations, then apply the disclosed preference."
    ],
    "alreadyRewritten": "Keep an exact recorded matching rewrite unchanged. Native reinstall recognizes and can keep the rewritten prompt hook.",
    "managedRolePaths": ["AGENTS.md", "CLAUDE.md"]
  }
