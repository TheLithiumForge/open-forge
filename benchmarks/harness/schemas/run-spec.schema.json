{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-forge.local/benchmarks/run-spec.schema.json",
  "title": "Open Forge benchmark run specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "caseId",
    "armId",
    "replicate",
    "evidenceClass",
    "sourceRepo",
    "components",
    "overrides",
    "inputs",
    "model",
    "runtime",
    "isolation",
    "controls"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "experimentId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "armId": { "$ref": "#/$defs/id" },
    "replicate": { "type": "integer", "minimum": 0 },
    "evidenceClass": { "enum": ["engineering-smoke", "pilot", "confirmatory"] },
    "sourceRepo": {
      "type": "string",
      "minLength": 1,
      "description": "Git repository with an existing HEAD. The runner records its real path, commit, tree, status, and staged/unstaged diffs before claiming a run."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered worker-visible inputs. Select package payload/ or core src/open-forge subtrees explicitly; package roots containing orchestrator, .git, or node_modules content are rejected.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "destination"],
        "properties": {
          "name": { "$ref": "#/$defs/id" },
          "source": { "type": "string", "minLength": 1 },
          "destination": { "type": "string" }
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "from", "to"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "prompt", "rubric"],
      "properties": {
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "invocation"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "invocation": {
              "type": "array",
              "minItems": 1,
              "description": "Shell-free argv. {runtime} resolves to the absolute current runtime executable, {cli} to the snapshotted CLI, and {workspace} to the worker workspace. The executable must resolve to an absolute path.",
              "items": { "type": "string" },
              "allOf": [
                { "contains": { "const": "{cli}" } },
                { "contains": { "const": "{workspace}" } },
                {
                  "anyOf": [
                    { "prefixItems": [{ "const": "{cli}" }] },
                    { "prefixItems": [{ "const": "{runtime}" }, { "const": "{cli}" }] }
                  ]
                }
              ]
            }
          }
        },
        "prompt": { "$ref": "#/$defs/fileArtifact" },
        "rubric": { "$ref": "#/$defs/fileArtifact" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id", "revision", "settings"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "settings": { "type": "object" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapter", "settings"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "settings": { "type": "object" }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshContext", "inheritedContext", "workerReceivesOnlyWorkspace", "network", "filesystem"],
      "properties": {
        "freshContext": { "enum": ["verified", "requested", "unverified"] },
        "inheritedContext": { "enum": ["none", "unknown", "present"] },
        "workerReceivesOnlyWorkspace": { "type": "boolean" },
        "network": { "enum": ["disabled", "enabled", "unknown"] },
        "filesystem": { "enum": ["workspace-only", "broader", "unknown"] }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "randomized", "declaredTreatmentOnly", "replicatePlanned", "planId", "planSha256"],
      "properties": {
        "planned": { "type": "boolean" },
        "randomized": { "type": "boolean" },
        "declaredTreatmentOnly": { "type": "boolean" },
        "replicatePlanned": { "type": "boolean" },
        "planId": { "type": ["string", "null"], "minLength": 1 },
        "planSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    }
  }
}
