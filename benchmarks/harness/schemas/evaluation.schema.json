{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-forge.local/benchmarks/evaluation.schema.json",
  "title": "Open Forge benchmark canonical evaluation",
  "description": "Finalized evaluation record. Source trace paths are replaced with immutable evidence-relative paths and hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "objectiveAssertions", "subjectiveRatings", "traces", "notes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["complete", "invalid", "aborted"] },
    "objectiveAssertions": { "$ref": "evaluation-input.schema.json#/properties/objectiveAssertions" },
    "subjectiveRatings": { "$ref": "evaluation-input.schema.json#/properties/subjectiveRatings" },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes", "evidencePath"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "evidencePath": { "type": "string", "pattern": "^traces/" }
        }
      }
    },
    "notes": { "$ref": "evaluation-input.schema.json#/properties/notes" }
  }
}
