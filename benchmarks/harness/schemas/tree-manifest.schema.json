{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-forge.local/benchmarks/tree-manifest.schema.json",
  "title": "Open Forge benchmark tree manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "digest", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "digest": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "sha256", "bytes", "mode"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "type": { "const": "file" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "mode": { "enum": [420, 493] }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
